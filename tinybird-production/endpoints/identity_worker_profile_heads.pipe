DESCRIPTION >
    Current active profiles for literal profile IDs.

NODE requested_identity_worker_profile_heads
SQL >
    %
    WITH candidates AS (
        SELECT
            profile_id,
            profile_key,
            winner_identifier_key,
            member_identifier_keys,
            historical_profile_ids,
            first_name,
            last_name,
            first_seen_at,
            last_seen_at,
            is_deleted,
            batch_version,
            committed_at,
            row_hash
        FROM identity_state_seed_enriched
        WHERE
            tenant_id = {{ String(p_tenant_id, 'boom') }}
            AND state_kind = 'profile'
            {% if defined(p_state_key) %}
                AND state_key = {{ String(p_state_key) }}
            {% else %}
                AND state_key IN {{ Array(p_state_keys, 'String') }}
            {% end %}
        UNION ALL
        SELECT
            journal.profile_id,
            journal.profile_key,
            journal.winner_identifier_key,
            journal.member_identifier_keys,
            journal.historical_profile_ids,
            journal.first_name,
            journal.last_name,
            journal.first_seen_at,
            journal.last_seen_at,
            journal.is_deleted,
            journal.batch_version,
            journal.committed_at,
            journal.row_hash
        FROM identity_state_delta_versions AS journal
        INNER JOIN activated_identity_batches AS activated
            ON journal.tenant_id = activated.tenant_id
            AND journal.batch_version = activated.batch_version
            AND journal.batch_id = activated.batch_id
        WHERE
            journal.tenant_id = {{ String(p_tenant_id, 'boom') }}
            AND journal.state_kind = 'profile'
            {% if defined(p_profile_id) %}
                AND journal.lookup_key = {{ String(p_profile_id) }}
            {% else %}
                AND journal.lookup_key IN {{ Array(p_profile_ids, 'String') }}
            {% end %}
    )
    SELECT
        profile_id,
        profile_key,
        winner_identifier_key,
        member_identifier_keys,
        historical_profile_ids,
        first_name,
        last_name,
        first_seen_at,
        last_seen_at
    FROM candidates
    QUALIFY
        row_number() OVER (
            PARTITION BY profile_id
            ORDER BY batch_version DESC, committed_at DESC, row_hash DESC
        ) = 1
        AND is_deleted = 0

TYPE ENDPOINT

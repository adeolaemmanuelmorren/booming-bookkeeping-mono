DESCRIPTION >
    Conversion source entities whose raw versions changed inside an ingestion
    window. The reporting facts coordinator rebuilds each returned entity's
    conversion facts completely and tombstones whatever the rebuild no longer
    produces.

NODE changed_client_form_entities
SQL >
    %
    SELECT
        'client_form' AS entity_kind,
        assumeNotNull(form_submission_id) AS entity_id,
        max(source_ingested_at) AS last_ingested_at
    FROM jitsu_form_submission_versions
    WHERE {{ String(p_entity_scope, 'client') }} = 'client'
        AND tenant_id = 'boom'
        AND form_submission_id IS NOT NULL
        AND source_ingested_at
            > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
        AND source_ingested_at
            <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY entity_id

NODE changed_client_order_entities
SQL >
    %
    SELECT
        'client_order' AS entity_kind,
        assumeNotNull(event_row_id) AS entity_id,
        max(source_ingested_at) AS last_ingested_at
    FROM jitsu_order_completed_versions
    WHERE {{ String(p_entity_scope, 'client') }} = 'client'
        AND tenant_id = 'boom'
        AND event_row_id IS NOT NULL
        AND source_ingested_at
            > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
        AND source_ingested_at
            <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY entity_id

NODE changed_server_form_contact_versions
SQL >
    %
    SELECT contact_id, max(changed_at) AS last_ingested_at
    FROM (
        SELECT contact_id, source_version AS changed_at
        FROM activecampaign_contact_tags_adapter
        WHERE {{ String(p_entity_scope, 'client') }} = 'server'
            AND source_version
                > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
            AND source_version
                <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
        UNION ALL
        SELECT contact_id, contact_updated_at AS changed_at
        FROM activecampaign_contacts_adapter
        WHERE {{ String(p_entity_scope, 'client') }} = 'server'
            AND contact_updated_at
                > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
            AND contact_updated_at
                <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
        UNION ALL
        SELECT assignment.contact_id AS contact_id, tag.source_version AS changed_at
        FROM activecampaign_contact_tags_adapter AS assignment
        INNER JOIN activecampaign_tags_adapter AS tag ON tag.tag_id = assignment.tag_id
        WHERE {{ String(p_entity_scope, 'client') }} = 'server'
            AND tag.source_version
                > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
            AND tag.source_version
                <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
    )
    WHERE contact_id != ''
    GROUP BY contact_id

NODE current_registration_form_facts
SQL >
    WITH
        replaceRegexpAll(trimBoth(ifNull(form.phone, '')), '[^0-9]', '') AS phone_digits,
        multiIf(
            length(phone_digits) = 10,
            phone_digits,
            length(phone_digits) = 11 AND startsWith(phone_digits, '1'),
            substring(phone_digits, 2),
            ''
        ) AS national_phone
    SELECT
        form.form_submission_id AS contact_tag_id,
        concat('server_form:', form.form_submission_id) AS conversion_id,
        form.submitted_at AS conversion_time,
        coalesce(
            if(form.email IS NULL, CAST(NULL AS Nullable(String)), concat('email:', form.email)),
            if(
                match(national_phone, '^[2-9][0-9]{2}[2-9][0-9]{6}$')
                AND substring(national_phone, 4, 3) != '555'
                AND NOT match(
                    national_phone,
                    '(0000000|1111111|2222222|3333333|4444444|5555555|6666666|7777777|8888888|9999999)$'
                )
                AND NOT match(
                    national_phone,
                    '^(0123456789|1234567890|234567890[0-9]|9876543210)$'
                ),
                concat('phone:+1', national_phone),
                CAST(NULL AS Nullable(String))
            ),
            ''
        ) AS identity_anchor_key,
        form.registration_type AS registration_type
    FROM activecampaign_registration_build AS form
    INNER JOIN changed_server_form_contact_versions AS changed
        ON changed.contact_id = assumeNotNull(form.contact_id)
    WHERE form.submitted_at IS NOT NULL

NODE current_server_form_fact_versions
SQL >
    SELECT *
    FROM (
        SELECT
            identity_anchor_key,
            conversion_id,
            conversion_time,
            registration_type,
            toUInt64(0) AS row_version,
            toUInt8(0) AS is_deleted
        FROM reporting_conversion_facts_v2_current
        WHERE tenant_id = 'boom' AND startsWith(conversion_id, 'server_form:')
        UNION ALL
        SELECT
            identity_anchor_key,
            conversion_id,
            conversion_time,
            registration_type,
            row_version,
            is_deleted
        FROM reporting_conversion_fact_deltas
        WHERE tenant_id = 'boom' AND startsWith(conversion_id, 'server_form:')
    )
    QUALIFY
        row_number() OVER (
            PARTITION BY identity_anchor_key, conversion_id
            ORDER BY row_version DESC
        ) = 1

NODE current_server_form_fact_heads
SQL >
    SELECT
        substring(fact.conversion_id, 13) AS contact_tag_id,
        fact.conversion_id AS conversion_id,
        fact.conversion_time AS conversion_time,
        fact.identity_anchor_key AS identity_anchor_key,
        fact.registration_type AS registration_type
    FROM current_server_form_fact_versions AS fact
    INNER JOIN activecampaign_contact_tags_adapter AS assignment
        ON assignment.contact_tag_id = substring(fact.conversion_id, 13)
    INNER JOIN changed_server_form_contact_versions AS changed
        ON changed.contact_id = assignment.contact_id
    WHERE fact.is_deleted = 0

NODE changed_or_new_server_form_ids
SQL >
    SELECT current.contact_tag_id AS contact_tag_id
    FROM current_registration_form_facts AS current
    LEFT ANTI JOIN current_server_form_fact_heads AS published
        ON published.conversion_id = current.conversion_id
        AND published.identity_anchor_key = current.identity_anchor_key
        AND published.conversion_time = current.conversion_time
        AND published.registration_type = current.registration_type

NODE removed_or_superseded_server_form_ids
SQL >
    SELECT published.contact_tag_id AS contact_tag_id
    FROM current_server_form_fact_heads AS published
    LEFT ANTI JOIN current_registration_form_facts AS current
        ON current.conversion_id = published.conversion_id
        AND current.identity_anchor_key = published.identity_anchor_key
        AND current.conversion_time = published.conversion_time
        AND current.registration_type = published.registration_type

NODE relevant_server_form_assignment_ids
SQL >
    SELECT contact_tag_id
    FROM (
        SELECT contact_tag_id FROM changed_or_new_server_form_ids
        UNION ALL
        SELECT contact_tag_id FROM removed_or_superseded_server_form_ids
    )
    GROUP BY contact_tag_id

NODE changed_server_form_entities
SQL >
    SELECT
        'server_form' AS entity_kind,
        relevant.contact_tag_id AS entity_id,
        max(changed.last_ingested_at) AS last_ingested_at
    FROM relevant_server_form_assignment_ids AS relevant
    INNER JOIN activecampaign_contact_tags_adapter AS assignment
        ON assignment.contact_tag_id = relevant.contact_tag_id
    INNER JOIN changed_server_form_contact_versions AS changed
        ON changed.contact_id = assignment.contact_id
    GROUP BY entity_id

NODE changed_server_payment_entities
SQL >
    %
    SELECT
        'server_payment' AS entity_kind,
        concat(payment_source, ':', payment_id) AS entity_id,
        max(source_version) AS last_ingested_at
    FROM stripe_identity_facts_adapter
    WHERE {{ String(p_entity_scope, 'client') }} = 'server'
        AND source_version
            > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
        AND source_version
            <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY entity_id

NODE changed_conversion_entities
SQL >
    %
    SELECT *
    FROM (
        SELECT * FROM changed_client_form_entities
        UNION ALL
        SELECT * FROM changed_client_order_entities
        UNION ALL
        SELECT * FROM changed_server_form_entities
        UNION ALL
        SELECT * FROM changed_server_payment_entities
    )
    ORDER BY last_ingested_at ASC, entity_kind ASC, entity_id ASC
    LIMIT {{ UInt64(p_limit, 2000) }}

TYPE ENDPOINT

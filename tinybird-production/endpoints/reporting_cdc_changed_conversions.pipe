DESCRIPTION >
    Conversion source entities whose raw versions changed inside an ingestion
    window. The reporting facts coordinator rebuilds each returned entity's
    conversion facts completely and tombstones whatever the rebuild no longer
    produces.

NODE changed_client_form_entities
SQL >
    %
    SELECT
        'client_form' AS entity_kind,
        assumeNotNull(form_submission_id) AS entity_id,
        max(source_ingested_at) AS last_ingested_at
    FROM jitsu_form_submission_versions
    WHERE {{ String(p_entity_scope, 'client') }} = 'client'
        AND tenant_id = 'boom'
        AND form_submission_id IS NOT NULL
        AND source_ingested_at
            > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
        AND source_ingested_at
            <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY entity_id

NODE changed_client_order_entities
SQL >
    %
    SELECT
        'client_order' AS entity_kind,
        assumeNotNull(event_row_id) AS entity_id,
        max(source_ingested_at) AS last_ingested_at
    FROM jitsu_order_completed_versions
    WHERE {{ String(p_entity_scope, 'client') }} = 'client'
        AND tenant_id = 'boom'
        AND event_row_id IS NOT NULL
        AND source_ingested_at
            > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
        AND source_ingested_at
            <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY entity_id

NODE changed_server_form_tag_semantics
SQL >
    %
    SELECT
        tag_id,
        max(candidate_source_version) AS source_version
    FROM (
        SELECT
            tag_id,
            source_version AS candidate_source_version,
            semantic_hash,
            lagInFrame(semantic_hash, 1, semantic_hash) OVER (
                PARTITION BY tag_id
                ORDER BY source_version
                ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
            ) AS previous_semantic_hash
        FROM activecampaign_tag_semantic_versions FINAL
    )
    WHERE candidate_source_version
            > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
        AND candidate_source_version
            <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
        AND semantic_hash != previous_semantic_hash
    GROUP BY tag_id

NODE changed_server_form_contact_versions
SQL >
    %
    SELECT contact_id, max(changed_at) AS last_ingested_at
    FROM (
        SELECT contact_id, source_version AS changed_at
        FROM activecampaign_contact_tags_adapter
        WHERE {{ String(p_entity_scope, 'client') }} = 'server'
            AND source_version
                > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
            AND source_version
                <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
        UNION ALL
        SELECT contact_id, contact_updated_at AS changed_at
        FROM activecampaign_contacts_adapter
        WHERE {{ String(p_entity_scope, 'client') }} = 'server'
            AND contact_updated_at
                > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
            AND contact_updated_at
                <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
        UNION ALL
        SELECT assignment.contact_id AS contact_id, tag.source_version AS changed_at
        FROM activecampaign_contact_tags_adapter AS assignment
        INNER JOIN changed_server_form_tag_semantics AS tag ON tag.tag_id = assignment.tag_id
        WHERE {{ String(p_entity_scope, 'client') }} = 'server'
    )
    WHERE contact_id != ''
    GROUP BY contact_id

NODE current_registration_form_assignments
SQL >
    SELECT assignment.contact_tag_id AS contact_tag_id
    FROM activecampaign_contact_tags_adapter AS assignment
    INNER JOIN changed_server_form_contact_versions AS changed
        ON changed.contact_id = assignment.contact_id
    INNER JOIN activecampaign_tags_adapter AS tag ON tag.tag_id = assignment.tag_id
    CROSS JOIN activecampaign_registration_tag_policy AS policy
    WHERE
        assignment.contact_tag_id != '0'
        AND assignment.is_deleted = false
        AND tag.is_deleted = false
        AND (
            (policy.tag_match_operator = 'exact' AND tag.tag_name = policy.tag_match_value)
            OR (
                policy.tag_match_operator = 'prefix'
                AND startsWith(tag.tag_name, policy.tag_match_value)
            )
        )
    GROUP BY contact_tag_id

NODE current_server_form_fact_versions
SQL >
    SELECT *
    FROM (
        SELECT
            identity_anchor_key,
            conversion_id,
            toUInt64(0) AS row_version,
            toUInt8(0) AS is_deleted
        FROM reporting_conversion_facts_v2_current
        WHERE tenant_id = 'boom' AND startsWith(conversion_id, 'server_form:')
        UNION ALL
        SELECT
            identity_anchor_key,
            conversion_id,
            row_version,
            is_deleted
        FROM reporting_conversion_fact_deltas
        WHERE tenant_id = 'boom' AND startsWith(conversion_id, 'server_form:')
    )
    QUALIFY
        row_number() OVER (
            PARTITION BY identity_anchor_key, conversion_id
            ORDER BY row_version DESC
        ) = 1

NODE current_server_form_fact_ids
SQL >
    SELECT substring(conversion_id, 13) AS contact_tag_id
    FROM current_server_form_fact_versions
    WHERE is_deleted = 0
    GROUP BY contact_tag_id

NODE relevant_server_form_assignment_ids
SQL >
    SELECT contact_tag_id
    FROM (
        SELECT contact_tag_id FROM current_registration_form_assignments
        UNION ALL
        SELECT contact_tag_id FROM current_server_form_fact_ids
    )
    GROUP BY contact_tag_id

NODE changed_server_form_entities
SQL >
    SELECT
        'server_form' AS entity_kind,
        relevant.contact_tag_id AS entity_id,
        max(changed.last_ingested_at) AS last_ingested_at
    FROM relevant_server_form_assignment_ids AS relevant
    INNER JOIN activecampaign_contact_tags_adapter AS assignment
        ON assignment.contact_tag_id = relevant.contact_tag_id
    INNER JOIN changed_server_form_contact_versions AS changed
        ON changed.contact_id = assignment.contact_id
    GROUP BY entity_id

NODE changed_server_payment_entities
SQL >
    %
    SELECT
        'server_payment' AS entity_kind,
        concat(payment_source, ':', payment_id) AS entity_id,
        max(source_version) AS last_ingested_at
    FROM stripe_identity_facts_adapter
    WHERE {{ String(p_entity_scope, 'client') }} = 'server'
        AND source_version
            > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
        AND source_version
            <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY entity_id

NODE changed_conversion_entities
SQL >
    %
    SELECT *
    FROM (
        SELECT * FROM changed_client_form_entities
        UNION ALL
        SELECT * FROM changed_client_order_entities
        UNION ALL
        SELECT * FROM changed_server_form_entities
        UNION ALL
        SELECT * FROM changed_server_payment_entities
    )
    ORDER BY last_ingested_at ASC, entity_kind ASC, entity_id ASC
    LIMIT {{ UInt64(p_limit, 2000) }}

TYPE ENDPOINT

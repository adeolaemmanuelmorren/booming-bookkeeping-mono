DESCRIPTION >
    Current page-view contract over physical version state.

NODE recently_ingested_page_view_keys
SQL >
    %
    SELECT tenant_id, __tb_state_key
    FROM jitsu_page_view_versions
    WHERE
        {{ String(p_identity_producer, 'all') }} = 'source_identity:segment_page_view'
        AND __tb_state_key != ''
        AND source_ingested_at
        >= toDateTime64({{ String(p_source_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY tenant_id, __tb_state_key

NODE ranked_page_view_versions
SQL >
    %
    SELECT
        source.*,
        row_number() OVER (
            PARTITION BY source.tenant_id, source.page_view_id
            ORDER BY
                source.source_priority DESC,
                source.source_fact_version DESC,
                source.source_ingested_at DESC,
                source.payload_hash DESC
        ) AS current_version_rank
    FROM jitsu_page_view_versions AS source
    WHERE
        {{ String(p_identity_producer, 'all') }} = 'all'
        OR (
            {{ String(p_identity_producer, 'all') }} = 'source_identity:segment_page_view'
            AND (source.tenant_id, source.__tb_state_key)
            IN (SELECT tenant_id, __tb_state_key FROM recently_ingested_page_view_keys)
        )

NODE current_page_view_rows
SQL >
    SELECT
        tenant_id,
        page_view_id,
        source_system,
        anonymous_id,
        user_id,
        page_view_timestamp,
        page_url,
        page_path,
        page_title,
        page_referrer,
        ip_address,
        user_agent,
        device_platform,
        device_is_mobile,
        geo_city,
        geo_region,
        geo_region_code,
        geo_country,
        geo_timezone,
        url_utm_source,
        url_utm_medium,
        utm_campaign,
        url_utm_campaign,
        utm_content,
        url_utm_content,
        utm_term,
        utm_id,
        url_utm_id,
        gclid,
        gbraid,
        wbraid,
        stored_fbclid,
        url_fbclid,
        fbclid,
        ttclid,
        li_fat_id,
        rdt_cid,
        twclid,
        fbc,
        fbp,
        ttp,
        uetsid,
        uetvid,
        google_campaign_id,
        google_ad_group_id,
        url_h_ad_id,
        google_keyword_id,
        google_keyword,
        meta_adset_id,
        url_meta_adset_id,
        source_partition_time,
        page_host,
        page_referrer_host,
        utm_source,
        is_identified_meta_ad_click,
        fbclid_observation_type,
        utm_medium,
        page_path_host,
        google_ad_id,
        campaign_id,
        adset_id,
        ad_id,
        click_id,
        click_id_type,
        channel_source,
        channel_medium,
        source_version
    FROM ranked_page_view_versions
    WHERE current_version_rank = 1 AND source_deleted = 0

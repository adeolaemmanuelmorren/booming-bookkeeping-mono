DESCRIPTION >
    Unified paid and non-paid acquisition performance with distinct client and server conversion measures.

NODE organic_performance_in_paid_column_order
SQL >
    SELECT
        organic_rows.date AS date,
        organic_rows.source AS source,
        organic_rows.campaign_id AS campaign_id,
        organic_rows.adset_id AS adset_id,
        organic_rows.ad_id AS ad_id,
        organic_rows.campaign_name AS campaign_name,
        organic_rows.adset_name AS adset_name,
        organic_rows.ad_name AS ad_name,
        organic_rows.medium AS medium,
        organic_rows.secondary_drill_down AS secondary_drill_down,
        organic_rows.tertiary_drill_down AS tertiary_drill_down,
        organic_rows.currency AS currency,
        organic_rows.impressions AS impressions,
        organic_rows.clicks AS clicks,
        organic_rows.unique_clicks AS unique_clicks,
        organic_rows.unique_inline_link_clicks AS unique_inline_link_clicks,
        organic_rows.spend AS spend,
        organic_rows.platform_conversions AS platform_conversions,
        organic_rows.platform_conversion_value AS platform_conversion_value,
        organic_rows.form_submissions_server_side_mt AS form_submissions_server_side_mt,
        organic_rows.form_submissions_server_side_ft AS form_submissions_server_side_ft,
        organic_rows.form_submissions_server_side_lt AS form_submissions_server_side_lt,
        organic_rows.krc_registrations_server_side_mt AS krc_registrations_server_side_mt,
        organic_rows.krc_registrations_server_side_ft AS krc_registrations_server_side_ft,
        organic_rows.krc_registrations_server_side_lt AS krc_registrations_server_side_lt,
        organic_rows.form_submissions_client_side_mt AS form_submissions_client_side_mt,
        organic_rows.form_submissions_client_side_ft AS form_submissions_client_side_ft,
        organic_rows.form_submissions_client_side_lt AS form_submissions_client_side_lt,
        organic_rows.order_completed_server_side_mt AS order_completed_server_side_mt,
        organic_rows.order_completed_server_side_ft AS order_completed_server_side_ft,
        organic_rows.order_completed_server_side_lt AS order_completed_server_side_lt,
        organic_rows.order_completed_client_side_mt AS order_completed_client_side_mt,
        organic_rows.order_completed_client_side_ft AS order_completed_client_side_ft,
        organic_rows.order_completed_client_side_lt AS order_completed_client_side_lt,
        organic_rows.payments_server_side_mt AS payments_server_side_mt,
        organic_rows.payments_server_side_ft AS payments_server_side_ft,
        organic_rows.payments_server_side_lt AS payments_server_side_lt,
        organic_rows.payments_client_side_mt AS payments_client_side_mt,
        organic_rows.payments_client_side_ft AS payments_client_side_ft,
        organic_rows.payments_client_side_lt AS payments_client_side_lt,
        organic_rows.revenue_server_side_mt AS revenue_server_side_mt,
        organic_rows.revenue_server_side_ft AS revenue_server_side_ft,
        organic_rows.revenue_server_side_lt AS revenue_server_side_lt,
        organic_rows.revenue_client_side_mt AS revenue_client_side_mt,
        organic_rows.revenue_client_side_ft AS revenue_client_side_ft,
        organic_rows.revenue_client_side_lt AS revenue_client_side_lt,
        organic_rows.customers_server_side_mt AS customers_server_side_mt,
        organic_rows.customers_server_side_ft AS customers_server_side_ft,
        organic_rows.customers_server_side_lt AS customers_server_side_lt,
        organic_rows.bbb_buyers_server_side_mt AS bbb_buyers_server_side_mt,
        organic_rows.bbb_buyers_server_side_ft AS bbb_buyers_server_side_ft,
        organic_rows.bbb_buyers_server_side_lt AS bbb_buyers_server_side_lt,
        organic_rows.bbb_revenue_server_side_mt AS bbb_revenue_server_side_mt,
        organic_rows.bbb_revenue_server_side_ft AS bbb_revenue_server_side_ft,
        organic_rows.bbb_revenue_server_side_lt AS bbb_revenue_server_side_lt,
        organic_rows.payments_vip_server_side_mt AS payments_vip_server_side_mt,
        organic_rows.payments_vip_server_side_ft AS payments_vip_server_side_ft,
        organic_rows.payments_vip_server_side_lt AS payments_vip_server_side_lt,
        organic_rows.payments_book_server_side_mt AS payments_book_server_side_mt,
        organic_rows.payments_book_server_side_ft AS payments_book_server_side_ft,
        organic_rows.payments_book_server_side_lt AS payments_book_server_side_lt,
        organic_rows.payments_mentorship_server_side_mt AS payments_mentorship_server_side_mt,
        organic_rows.payments_mentorship_server_side_ft AS payments_mentorship_server_side_ft,
        organic_rows.payments_mentorship_server_side_lt AS payments_mentorship_server_side_lt,
        organic_rows.payments_kajabi_server_side_mt AS payments_kajabi_server_side_mt,
        organic_rows.payments_kajabi_server_side_ft AS payments_kajabi_server_side_ft,
        organic_rows.payments_kajabi_server_side_lt AS payments_kajabi_server_side_lt,
        organic_rows.payments_catalog_server_side_mt AS payments_catalog_server_side_mt,
        organic_rows.payments_catalog_server_side_ft AS payments_catalog_server_side_ft,
        organic_rows.payments_catalog_server_side_lt AS payments_catalog_server_side_lt,
        organic_rows.payments_unknown_server_side_mt AS payments_unknown_server_side_mt,
        organic_rows.payments_unknown_server_side_ft AS payments_unknown_server_side_ft,
        organic_rows.payments_unknown_server_side_lt AS payments_unknown_server_side_lt,
        organic_rows.revenue_vip_server_side_mt AS revenue_vip_server_side_mt,
        organic_rows.revenue_vip_server_side_ft AS revenue_vip_server_side_ft,
        organic_rows.revenue_vip_server_side_lt AS revenue_vip_server_side_lt,
        organic_rows.revenue_book_server_side_mt AS revenue_book_server_side_mt,
        organic_rows.revenue_book_server_side_ft AS revenue_book_server_side_ft,
        organic_rows.revenue_book_server_side_lt AS revenue_book_server_side_lt,
        organic_rows.revenue_mentorship_server_side_mt AS revenue_mentorship_server_side_mt,
        organic_rows.revenue_mentorship_server_side_ft AS revenue_mentorship_server_side_ft,
        organic_rows.revenue_mentorship_server_side_lt AS revenue_mentorship_server_side_lt,
        organic_rows.revenue_kajabi_server_side_mt AS revenue_kajabi_server_side_mt,
        organic_rows.revenue_kajabi_server_side_ft AS revenue_kajabi_server_side_ft,
        organic_rows.revenue_kajabi_server_side_lt AS revenue_kajabi_server_side_lt,
        organic_rows.revenue_catalog_server_side_mt AS revenue_catalog_server_side_mt,
        organic_rows.revenue_catalog_server_side_ft AS revenue_catalog_server_side_ft,
        organic_rows.revenue_catalog_server_side_lt AS revenue_catalog_server_side_lt,
        organic_rows.revenue_unknown_server_side_mt AS revenue_unknown_server_side_mt,
        organic_rows.revenue_unknown_server_side_ft AS revenue_unknown_server_side_ft,
        organic_rows.revenue_unknown_server_side_lt AS revenue_unknown_server_side_lt,
        CAST(NULL AS Nullable(Float64)) AS roas_vip_mt,
        CAST(NULL AS Nullable(Float64)) AS roas_book_mt,
        CAST(NULL AS Nullable(Float64)) AS roas_mentorship_mt,
        CAST(NULL AS Nullable(Float64)) AS roas_kajabi_mt,
        CAST(NULL AS Nullable(Float64)) AS roas_catalog_mt,
        CAST(NULL AS Nullable(Float64)) AS roas_unknown_mt,
        CAST(NULL AS Nullable(Float64)) AS roas_all_payments_mt
    FROM mart_conversions_organic_performance AS organic_rows

NODE mart_conversions_all_performance_rows
SQL >
    SELECT paid_rows.*
    FROM mart_conversions_ad_performance AS paid_rows
    UNION ALL
    SELECT organic_rows.*
    FROM organic_performance_in_paid_column_order AS organic_rows

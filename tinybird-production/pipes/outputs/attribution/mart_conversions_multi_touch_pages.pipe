DESCRIPTION >
    Multi-touch conversion metrics rolled up to the landing-page and click-date grain.

NODE landing_page_conversion_rows
SQL >
    SELECT
        click_date,
        landing_page_host,
        landing_page_path,
        toInt64(sum(sessions)) AS sessions,
        sum(form_submissions_server_side_mt) AS form_submissions_server_side_mt,
        sum(form_submissions_server_side_ft) AS form_submissions_server_side_ft,
        sum(form_submissions_server_side_lt) AS form_submissions_server_side_lt,
        sum(krc_registrations_server_side_mt) AS krc_registrations_server_side_mt,
        sum(krc_registrations_server_side_ft) AS krc_registrations_server_side_ft,
        sum(krc_registrations_server_side_lt) AS krc_registrations_server_side_lt,
        sum(form_submissions_client_side_mt) AS form_submissions_client_side_mt,
        sum(form_submissions_client_side_ft) AS form_submissions_client_side_ft,
        sum(form_submissions_client_side_lt) AS form_submissions_client_side_lt,
        sum(order_completed_server_side_mt) AS order_completed_server_side_mt,
        sum(order_completed_server_side_ft) AS order_completed_server_side_ft,
        sum(order_completed_server_side_lt) AS order_completed_server_side_lt,
        sum(order_completed_client_side_mt) AS order_completed_client_side_mt,
        sum(order_completed_client_side_ft) AS order_completed_client_side_ft,
        sum(order_completed_client_side_lt) AS order_completed_client_side_lt,
        sum(payments_server_side_mt) AS payments_server_side_mt,
        sum(payments_server_side_ft) AS payments_server_side_ft,
        sum(payments_server_side_lt) AS payments_server_side_lt,
        sum(payments_client_side_mt) AS payments_client_side_mt,
        sum(payments_client_side_ft) AS payments_client_side_ft,
        sum(payments_client_side_lt) AS payments_client_side_lt,
        sum(revenue_server_side_mt) AS revenue_server_side_mt,
        sum(revenue_server_side_ft) AS revenue_server_side_ft,
        sum(revenue_server_side_lt) AS revenue_server_side_lt,
        sum(revenue_client_side_mt) AS revenue_client_side_mt,
        sum(revenue_client_side_ft) AS revenue_client_side_ft,
        sum(revenue_client_side_lt) AS revenue_client_side_lt,
        sum(customers_server_side_mt) AS customers_server_side_mt,
        sum(customers_server_side_ft) AS customers_server_side_ft,
        sum(customers_server_side_lt) AS customers_server_side_lt,
        sum(bbb_buyers_server_side_mt) AS bbb_buyers_server_side_mt,
        sum(bbb_buyers_server_side_ft) AS bbb_buyers_server_side_ft,
        sum(bbb_buyers_server_side_lt) AS bbb_buyers_server_side_lt,
        sum(bbb_revenue_server_side_mt) AS bbb_revenue_server_side_mt,
        sum(bbb_revenue_server_side_ft) AS bbb_revenue_server_side_ft,
        sum(bbb_revenue_server_side_lt) AS bbb_revenue_server_side_lt,
        sum(payments_vip_server_side_mt) AS payments_vip_server_side_mt,
        sum(payments_vip_server_side_ft) AS payments_vip_server_side_ft,
        sum(payments_vip_server_side_lt) AS payments_vip_server_side_lt,
        sum(payments_book_server_side_mt) AS payments_book_server_side_mt,
        sum(payments_book_server_side_ft) AS payments_book_server_side_ft,
        sum(payments_book_server_side_lt) AS payments_book_server_side_lt,
        sum(payments_mentorship_server_side_mt) AS payments_mentorship_server_side_mt,
        sum(payments_mentorship_server_side_ft) AS payments_mentorship_server_side_ft,
        sum(payments_mentorship_server_side_lt) AS payments_mentorship_server_side_lt,
        sum(payments_kajabi_server_side_mt) AS payments_kajabi_server_side_mt,
        sum(payments_kajabi_server_side_ft) AS payments_kajabi_server_side_ft,
        sum(payments_kajabi_server_side_lt) AS payments_kajabi_server_side_lt,
        sum(payments_catalog_server_side_mt) AS payments_catalog_server_side_mt,
        sum(payments_catalog_server_side_ft) AS payments_catalog_server_side_ft,
        sum(payments_catalog_server_side_lt) AS payments_catalog_server_side_lt,
        sum(payments_unknown_server_side_mt) AS payments_unknown_server_side_mt,
        sum(payments_unknown_server_side_ft) AS payments_unknown_server_side_ft,
        sum(payments_unknown_server_side_lt) AS payments_unknown_server_side_lt,
        sum(revenue_vip_server_side_mt) AS revenue_vip_server_side_mt,
        sum(revenue_vip_server_side_ft) AS revenue_vip_server_side_ft,
        sum(revenue_vip_server_side_lt) AS revenue_vip_server_side_lt,
        sum(revenue_book_server_side_mt) AS revenue_book_server_side_mt,
        sum(revenue_book_server_side_ft) AS revenue_book_server_side_ft,
        sum(revenue_book_server_side_lt) AS revenue_book_server_side_lt,
        sum(revenue_mentorship_server_side_mt) AS revenue_mentorship_server_side_mt,
        sum(revenue_mentorship_server_side_ft) AS revenue_mentorship_server_side_ft,
        sum(revenue_mentorship_server_side_lt) AS revenue_mentorship_server_side_lt,
        sum(revenue_kajabi_server_side_mt) AS revenue_kajabi_server_side_mt,
        sum(revenue_kajabi_server_side_ft) AS revenue_kajabi_server_side_ft,
        sum(revenue_kajabi_server_side_lt) AS revenue_kajabi_server_side_lt,
        sum(revenue_catalog_server_side_mt) AS revenue_catalog_server_side_mt,
        sum(revenue_catalog_server_side_ft) AS revenue_catalog_server_side_ft,
        sum(revenue_catalog_server_side_lt) AS revenue_catalog_server_side_lt,
        sum(revenue_unknown_server_side_mt) AS revenue_unknown_server_side_mt,
        sum(revenue_unknown_server_side_ft) AS revenue_unknown_server_side_ft,
        sum(revenue_unknown_server_side_lt) AS revenue_unknown_server_side_lt
    FROM mart_conversions_multi_touch_current
    GROUP BY click_date, landing_page_host, landing_page_path

DESCRIPTION >
    Scalar-only server-form conversion payload for reverse-ETL destinations that do
    not accept nested fields. Google Ads consumers read the rolling 14-day window.

NODE flattened_form_submission_rows
SQL >
    SELECT
        profile_id,
        anonymous_id,
        form_submission_id,
        contact_id,
        tag_id,
        tag_name,
        registration_tag_type,
        event_id,
        event_name,
        conversion_ts,
        email,
        phone,
        profile_first_name,
        profile_last_name,
        registration_type,
        content_name,
        content_type,
        form_type,
        event_source,
        pre_conversion_fbc,
        pre_conversion_fbp,
        compliant_email,
        compliant_phone,
        is_click,
        first_known_ip_address,
        last_known_ip_address,
        first_known_user_agent,
        last_known_user_agent,
        first_known_geo_city,
        first_known_geo_region,
        first_known_geo_country,
        last_known_geo_city,
        last_known_geo_region,
        last_known_geo_country,
        first_known_fbc,
        first_known_fbp,
        first_known_uetsid,
        first_known_uetvid,
        last_known_fbc,
        last_known_fbp,
        last_known_uetsid,
        last_known_uetvid,
        tupleElement(click_ids, 'gclid') AS gclid,
        tupleElement(click_ids, 'wbraid') AS wbraid,
        tupleElement(click_ids, 'gbraid') AS gbraid,
        tupleElement(click_ids, 'fbclid') AS fbclid,
        tupleElement(click_ids, 'ttclid') AS ttclid,
        tupleElement(payload, 'event_name') AS payload_event_name,
        tupleElement(payload, 'event_id') AS payload_event_id,
        tupleElement(payload, 'event_time') AS payload_event_time,
        tupleElement(payload, 'content_name') AS payload_content_name,
        tupleElement(payload, 'content_type') AS payload_content_type
    FROM segretl_form_submitted
    WHERE conversion_ts >= now64(6) - INTERVAL 14 DAY

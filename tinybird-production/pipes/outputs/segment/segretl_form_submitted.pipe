DESCRIPTION >
    Server-side ActiveCampaign registration conversions using the shared browser and
    server form mapping plus the latest eligible pre-conversion attribution context.

NODE mapped_server_form_submissions
SQL >
    SELECT
        profile_id,
        form_submission_id,
        contact_id,
        tag_id,
        tag_name,
        registration_tag_type,
        lowerUTF8(trim(assumeNotNull(email))) AS email,
        phone,
        first_name AS profile_first_name,
        last_name AS profile_last_name,
        assumeNotNull(submitted_at) AS conversion_ts,
        registration_type,
        content_name,
        assumeNotNull(canonical_event_id) AS event_id,
        form_type,
        event_source
    FROM mart_form_submissions_server_side
    WHERE email IS NOT NULL AND submitted_at IS NOT NULL AND canonical_event_id IS NOT NULL
    QUALIFY
        row_number() OVER (
            PARTITION BY canonical_event_id
            ORDER BY submitted_at ASC NULLS FIRST, form_submission_id ASC NULLS FIRST
        )
        = 1

NODE form_submission_click_context
SQL >
    SELECT
        forms.event_id,
        argMaxIf(
            touchpoints.anonymous_id, touchpoints.touchpoint_time, touchpoints.anonymous_id IS NOT NULL
        ) AS anonymous_id,
        argMaxIf(
            touchpoints.gclid, touchpoints.touchpoint_time, touchpoints.gclid IS NOT NULL
        ) AS gclid,
        argMaxIf(
            touchpoints.wbraid, touchpoints.touchpoint_time, touchpoints.wbraid IS NOT NULL
        ) AS wbraid,
        argMaxIf(
            touchpoints.gbraid, touchpoints.touchpoint_time, touchpoints.gbraid IS NOT NULL
        ) AS gbraid,
        argMaxIf(
            touchpoints.fbclid, touchpoints.touchpoint_time, touchpoints.fbclid IS NOT NULL
        ) AS fbclid,
        argMaxIf(
            touchpoints.fbc_fbclid,
            tuple(touchpoints.touchpoint_time, touchpoints.touchpoint_id),
            touchpoints.fbc_fbclid IS NOT NULL
        ) AS latest_preconversion_fbc_fbclid,
        argMaxIf(
            touchpoints.ttclid, touchpoints.touchpoint_time, touchpoints.ttclid IS NOT NULL
        ) AS ttclid
    FROM mapped_server_form_submissions AS forms
    INNER JOIN
        mart_touchpoints_all AS touchpoints
        ON touchpoints.profile_id = forms.profile_id
        AND touchpoints.touchpoint_time <= forms.conversion_ts
    GROUP BY forms.event_id

NODE form_submission_meta_context
SQL >
    SELECT
        forms.event_id,
        argMaxIf(
            attribution.fbc,
            tuple(attribution.event_time, attribution.event_id),
            attribution.fbc IS NOT NULL
        ) AS latest_preconversion_fbc,
        argMaxIf(
            attribution.fbp,
            tuple(attribution.event_time, attribution.event_id),
            attribution.fbp IS NOT NULL
        ) AS latest_preconversion_fbp
    FROM mapped_server_form_submissions AS forms
    INNER JOIN
        int_attribution_events AS attribution
        ON attribution.profile_id = forms.profile_id
        AND attribution.event_time <= forms.conversion_ts
    GROUP BY forms.event_id

NODE form_submission_payload_rows
SQL >
    SELECT
        forms.profile_id AS profile_id,
        clicks.anonymous_id AS anonymous_id,
        forms.form_submission_id AS form_submission_id,
        forms.contact_id AS contact_id,
        forms.tag_id AS tag_id,
        forms.tag_name AS tag_name,
        forms.registration_tag_type AS registration_tag_type,
        forms.event_id AS event_id,
        'CompleteRegistration' AS event_name,
        forms.conversion_ts AS conversion_ts,
        forms.email AS email,
        forms.phone AS phone,
        forms.profile_first_name AS profile_first_name,
        forms.profile_last_name AS profile_last_name,
        forms.registration_type AS registration_type,
        forms.content_name AS content_name,
        if(forms.registration_type = 'krc', 'krc-free', CAST(NULL AS Nullable(String))) AS content_type,
        forms.form_type AS form_type,
        forms.event_source AS event_source,
        CAST(
            tuple(
                clicks.gclid,
                if(clicks.gclid IS NULL, clicks.wbraid, CAST(NULL AS Nullable(String))),
                if(
                    clicks.gclid IS NULL AND clicks.wbraid IS NULL,
                    clicks.gbraid,
                    CAST(NULL AS Nullable(String))
                ),
                clicks.fbclid,
                clicks.ttclid
            ),
            'Tuple(gclid Nullable(String), wbraid Nullable(String), gbraid Nullable(String), fbclid Nullable(String), ttclid Nullable(String))'
        ) AS click_ids,
        coalesce(
            meta.latest_preconversion_fbc, clicks.latest_preconversion_fbc_fbclid
        ) AS pre_conversion_fbc,
        meta.latest_preconversion_fbp AS pre_conversion_fbp,
        if(
            clicks.gclid IS NOT NULL
            OR (clicks.gclid IS NULL AND clicks.wbraid IS NULL AND clicks.gbraid IS NULL),
            forms.email,
            CAST(NULL AS Nullable(String))
        ) AS compliant_email,
        if(
            clicks.gclid IS NOT NULL
            OR (clicks.gclid IS NULL AND clicks.wbraid IS NULL AND clicks.gbraid IS NULL),
            forms.phone,
            CAST(NULL AS Nullable(String))
        ) AS compliant_phone,
        toBool(
            clicks.gclid IS NOT NULL
            OR clicks.wbraid IS NOT NULL
            OR clicks.gbraid IS NOT NULL
            OR clicks.fbclid IS NOT NULL
            OR clicks.ttclid IS NOT NULL
        ) AS is_click,
        coalesce(traits.first_known_ip_address, '127.0.0.1') AS first_known_ip_address,
        coalesce(traits.last_known_ip_address, '127.0.0.1') AS last_known_ip_address,
        coalesce(
            traits.first_known_user_agent, 'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)'
        ) AS first_known_user_agent,
        coalesce(
            traits.last_known_user_agent, 'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)'
        ) AS last_known_user_agent,
        traits.first_known_geo_city AS first_known_geo_city,
        traits.first_known_geo_region AS first_known_geo_region,
        traits.first_known_geo_country AS first_known_geo_country,
        traits.last_known_geo_city AS last_known_geo_city,
        traits.last_known_geo_region AS last_known_geo_region,
        traits.last_known_geo_country AS last_known_geo_country,
        traits.first_known_fbc AS first_known_fbc,
        traits.first_known_fbp AS first_known_fbp,
        traits.first_known_uetsid AS first_known_uetsid,
        traits.first_known_uetvid AS first_known_uetvid,
        traits.last_known_fbc AS last_known_fbc,
        traits.last_known_fbp AS last_known_fbp,
        traits.last_known_uetsid AS last_known_uetsid,
        traits.last_known_uetvid AS last_known_uetvid,
        CAST(
            tuple(
                'CompleteRegistration',
                forms.event_id,
                forms.conversion_ts,
                forms.content_name,
                if(forms.registration_type = 'krc', 'krc-free', CAST(NULL AS Nullable(String)))
            ),
            'Tuple(event_name String, event_id String, event_time DateTime64(6), content_name String, content_type Nullable(String))'
        ) AS payload
    FROM mapped_server_form_submissions AS forms
    LEFT JOIN form_submission_click_context AS clicks ON clicks.event_id = forms.event_id
    LEFT JOIN form_submission_meta_context AS meta ON meta.event_id = forms.event_id
    LEFT JOIN int_attribution_traits AS traits ON traits.profile_id = forms.profile_id

DESCRIPTION >
    Scalar-only version of segretl_repeatable_conversions for reverse-ETL
    destinations that do not accept nested fields.

NODE flattened_repeatable_conversion_rows
SQL >
    SELECT
        payment_source,
        payment_id,
        profile_id,
        anonymous_id,
        event_id,
        event_name,
        conversion_ts,
        email,
        phone,
        profile_first_name,
        profile_last_name,
        product_case,
        product_resolution_source,
        product_id,
        payment_occurrence_type,
        is_repeat_payment,
        content_name,
        content_type,
        value,
        currency,
        num_items,
        pre_conversion_fbc,
        pre_conversion_fbp,
        compliant_email,
        compliant_phone,
        is_click,
        pre_conversion_ip_address,
        first_known_ip_address,
        last_known_ip_address,
        first_known_user_agent,
        last_known_user_agent,
        first_known_geo_city,
        first_known_geo_region,
        first_known_geo_country,
        last_known_geo_city,
        last_known_geo_region,
        last_known_geo_country,
        first_known_fbc,
        first_known_fbp,
        first_known_uetsid,
        first_known_uetvid,
        last_known_fbc,
        last_known_fbp,
        last_known_uetsid,
        last_known_uetvid,
        tupleElement(address, 'address_line_1') AS address_line_1,
        tupleElement(address, 'city') AS address_city,
        tupleElement(address, 'region') AS address_region,
        tupleElement(address, 'zip') AS address_zip,
        tupleElement(address, 'country') AS address_country,
        toJSONString(content_ids) AS content_ids_json,
        toJSONString(fb_content_ids) AS fb_content_ids_json,
        toJSONString(contents) AS contents_json,
        toJSONString(fb_contents) AS fb_contents_json,
        tupleElement(click_ids, 'gclid') AS gclid,
        tupleElement(click_ids, 'wbraid') AS wbraid,
        tupleElement(click_ids, 'gbraid') AS gbraid,
        tupleElement(click_ids, 'fbclid') AS fbclid,
        tupleElement(click_ids, 'ttclid') AS ttclid,
        tupleElement(payload, 'event_name') AS payload_event_name,
        tupleElement(payload, 'event_id') AS payload_event_id,
        tupleElement(payload, 'event_time') AS payload_event_time,
        tupleElement(payload, 'product_case') AS payload_product_case,
        tupleElement(payload, 'product_id') AS payload_product_id,
        toJSONString(tupleElement(payload, 'content_ids')) AS payload_content_ids_json,
        toJSONString(tupleElement(payload, 'fb_content_ids')) AS payload_fb_content_ids_json,
        toJSONString(tupleElement(payload, 'fb_contents')) AS payload_fb_contents_json,
        tupleElement(payload, 'content_name') AS payload_content_name,
        tupleElement(payload, 'content_type') AS payload_content_type,
        tupleElement(payload, 'value') AS payload_value,
        tupleElement(payload, 'currency') AS payload_currency,
        tupleElement(tupleElement(payload, 'address'), 'address_line_1') AS payload_address_line_1,
        tupleElement(tupleElement(payload, 'address'), 'city') AS payload_address_city,
        tupleElement(tupleElement(payload, 'address'), 'region') AS payload_address_region,
        tupleElement(tupleElement(payload, 'address'), 'zip') AS payload_address_zip,
        tupleElement(tupleElement(payload, 'address'), 'country') AS payload_address_country
    FROM segretl_repeatable_conversions

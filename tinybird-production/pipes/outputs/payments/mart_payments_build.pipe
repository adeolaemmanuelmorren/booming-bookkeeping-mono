DESCRIPTION >
    Canonical successful payments across both Stripe accounts, matching the Dataform
    mart contract while delegating reusable identity resolution to resolved_payments.

NODE mart_payment_rows
SQL >
    SELECT
        payment_source,
        payment_id,
        payment_time,
        payment_date,
        customer_id,
        payment_email,
        payment_name,
        payment_phone,
        billing_address_line_1,
        billing_address_city,
        billing_address_region,
        billing_address_zip,
        billing_address_country,
        currency,
        amount_paid,
        refund_amount,
        net_amount,
        has_refund,
        product_id,
        product_name,
        product_variant,
        price_id,
        plan_id,
        product_rule,
        product_classification_method,
        is_product_classified,
        is_bbb_mentorship_installment,
        payment_sequence_number,
        payment_occurrence_type,
        is_repeat_payment,
        payment_intent_id,
        payment_method_id,
        invoice_id,
        subscription_id,
        checkout_session_id,
        payment_link_id,
        invoice_billing_reason,
        checkout_mode,
        has_discount,
        discount_amount,
        discount_ids,
        coupon_ids,
        coupon_names,
        promotion_code_ids,
        promotion_codes,
        coupon_amount_off,
        coupon_percent_off,
        charge_description,
        calculated_statement_descriptor,
        statement_descriptor,
        payment_intent_description,
        invoice_description,
        book_product_text,
        receipt_url,
        livemode,
        product_complete_name,
        content_ids,
        automatic_profile_id,
        payment_category,
        manual_profile_id,
        profile_id,
        attribution_method,
        first_name,
        last_name,
        manual_link_created_at,
        manual_link_created_by
    FROM reporting_resolved_payments

DESCRIPTION >
    Resolve the prior profile IDs touched by one classified identity batch.

NODE seeded_identity_compaction_profiles
SQL >
    %
    WITH
        identity_compaction_profiles_request AS (
            SELECT
                {{ String(p_tenant_id, 'boom') }} AS tenant_id,
                {{ UInt64(p_batch_version, 0) }} AS batch_version,
                {{ String(p_batch_id, '') }} AS batch_id
        ),
        selected_profiles_metadata AS (
            SELECT prepared.*
            FROM identity_compaction_changes_stage AS prepared
            INNER JOIN
                identity_compaction_profiles_request AS request
                ON prepared.tenant_id = request.tenant_id
                AND prepared.batch_version = request.batch_version
                AND prepared.batch_id = request.batch_id
            WHERE prepared.stage_kind = 'metadata'
            QUALIFY
                row_number() OVER (
                    PARTITION BY prepared.tenant_id, prepared.batch_version, prepared.batch_id
                    ORDER BY prepared.staged_at, prepared.stage_hash
                )
                = 1
        ),
        selected_changed_facts AS (
            SELECT prepared.*
            FROM identity_compaction_changes_stage AS prepared
            INNER JOIN
                selected_profiles_metadata AS metadata
                ON prepared.tenant_id = metadata.tenant_id
                AND prepared.batch_version = metadata.batch_version
                AND prepared.batch_id = metadata.batch_id
                AND prepared.input_hash = metadata.input_hash
            WHERE prepared.stage_kind = 'changed_fact'
            QUALIFY
                row_number() OVER (
                    PARTITION BY prepared.tenant_id, prepared.stage_kind, prepared.stage_key
                    ORDER BY prepared.staged_at, prepared.stage_hash
                )
                = 1
        ),
        changed_identity_identifier_keys AS (
            SELECT
                stable.tenant_id AS tenant_id,
                identifier_key,
                concat(
                    'mapping:', toString(length(identifier_key)), ':', identifier_key
                ) AS state_key
            FROM selected_changed_facts AS stable ARRAY
            JOIN stable.stable_evidence_keys AS identifier_key
            WHERE
                stable.stable_is_deleted = 0
                AND stable.stable_fact_deleted = 0
                AND position(identifier_key, ':') > 1
            UNION
            DISTINCT
            SELECT
                incoming.tenant_id AS tenant_id,
                identifier_key,
                concat(
                    'mapping:', toString(length(identifier_key)), ':', identifier_key
                ) AS state_key
            FROM selected_changed_facts AS incoming ARRAY
            JOIN incoming.evidence_keys AS identifier_key
            WHERE incoming.fact_deleted = 0 AND position(identifier_key, ':') > 1
        ),
        profiles_activated_identity_batches AS (
            SELECT tenant_id, batch_version, batch_id
            FROM
                (
                    SELECT
                        journal.tenant_id AS tenant_id,
                        journal.batch_version AS batch_version,
                        journal.batch_id AS batch_id,
                        journal.committed_at AS committed_at,
                        journal.row_hash AS row_hash,
                        metadata.active_batch_version AS active_batch_version,
                        metadata.active_batch_id AS active_batch_id
                    FROM identity_state_delta_versions AS journal
                    INNER JOIN
                        selected_profiles_metadata AS metadata
                        ON journal.tenant_id = metadata.tenant_id
                    WHERE journal.state_kind = 'activation_audit' AND journal.is_deleted = 0
                    QUALIFY
                        row_number() OVER (
                            PARTITION BY journal.tenant_id, journal.batch_version
                            ORDER BY
                                journal.committed_at DESC, journal.row_hash DESC, journal.batch_id DESC
                        )
                        = 1
                ) AS activated
            WHERE
                activated.batch_version < activated.active_batch_version
                OR (
                    activated.batch_version = activated.active_batch_version
                    AND activated.batch_id = activated.active_batch_id
                )
        ),
        candidate_changed_mapping_versions AS (
            SELECT
                seed.tenant_id AS tenant_id,
                seed.identifier_key AS identifier_key,
                seed.profile_id AS profile_id,
                seed.is_deleted AS is_deleted,
                seed.batch_version AS batch_version,
                seed.committed_at AS committed_at,
                seed.row_hash AS row_hash
            FROM identity_state_seed_enriched AS seed
            WHERE
                seed.state_kind = 'mapping'
                AND (seed.tenant_id, seed.state_key)
                IN (SELECT tenant_id, state_key FROM changed_identity_identifier_keys)
            UNION ALL
            SELECT
                journal.tenant_id AS tenant_id,
                journal.identifier_key AS identifier_key,
                journal.profile_id AS profile_id,
                journal.is_deleted AS is_deleted,
                journal.batch_version AS batch_version,
                journal.committed_at AS committed_at,
                journal.row_hash AS row_hash
            FROM identity_state_delta_versions AS journal
            INNER JOIN
                profiles_activated_identity_batches AS activated
                ON journal.tenant_id = activated.tenant_id
                AND journal.batch_version = activated.batch_version
                AND journal.batch_id = activated.batch_id
            WHERE
                journal.state_kind = 'mapping'
                AND (journal.tenant_id, journal.lookup_key)
                IN (SELECT tenant_id, identifier_key FROM changed_identity_identifier_keys)
        ),
        latest_changed_mapping_versions AS (
            SELECT *
            FROM candidate_changed_mapping_versions
            QUALIFY
                row_number() OVER (
                    PARTITION BY tenant_id, identifier_key
                    ORDER BY batch_version DESC, committed_at DESC, row_hash DESC
                )
                = 1
        ),
        touched_prior_profile_ids AS (
            SELECT tenant_id, profile_id
            FROM latest_changed_mapping_versions
            WHERE is_deleted = 0 AND profile_id != ''
            GROUP BY tenant_id, profile_id
        )
    SELECT
        profiles.tenant_id AS tenant_id,
        metadata.batch_version AS batch_version,
        metadata.batch_id AS batch_id,
        'prior_profile' AS stage_kind,
        profiles.profile_id AS stage_key,
        metadata.staged_at AS staged_at,
        CAST(
            lower(
                hex(SHA256(concat('prior_profile:', profiles.profile_id, ':', metadata.input_hash)))
            ) AS FixedString(64)
        ) AS stage_hash,
        metadata.input_event_count AS input_event_count,
        metadata.input_hash AS input_hash,
        metadata.checkpoint_ingested_at AS checkpoint_ingested_at,
        metadata.checkpoint_event_id AS checkpoint_event_id,
        metadata.active_batch_version AS active_batch_version,
        metadata.active_batch_id AS active_batch_id,
        '' AS producer_id,
        toDateTime64(0, 6) AS observed_at,
        '' AS fact_kind,
        '' AS fact_key,
        toUInt64(0) AS source_fact_version,
        toUInt8(0) AS fact_deleted,
        CAST(repeat('0', 64) AS FixedString(64)) AS fact_payload_hash,
        '' AS fact_payload,
        CAST([], 'Array(String)') AS evidence_keys,
        toUInt8(0) AS stable_is_deleted,
        toUInt8(0) AS stable_fact_deleted,
        toDateTime64(0, 6) AS stable_fact_observed_at,
        CAST([], 'Array(String)') AS stable_evidence_keys,
        profiles.profile_id AS prior_profile_id
    FROM touched_prior_profile_ids AS profiles
    INNER JOIN selected_profiles_metadata AS metadata ON profiles.tenant_id = metadata.tenant_id

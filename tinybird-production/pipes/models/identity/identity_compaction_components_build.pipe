DESCRIPTION >
    Compute the exact affected component members for one scoped identity batch. This
    physical boundary prevents the final Copy from expanding the graph once per delta.

NODE staged_identity_compaction_component_rows
SQL >
    %
    WITH
        identity_compaction_components_request AS (
            SELECT
                {{ String(p_tenant_id, 'boom') }} AS tenant_id,
                {{ UInt64(p_batch_version, 0) }} AS batch_version,
                {{ String(p_batch_id, '') }} AS batch_id
        ),
        component_prepared_metadata_candidates AS (
            SELECT prepared.*
            FROM identity_compaction_changes_stage AS prepared
            INNER JOIN
                identity_compaction_components_request AS request
                ON prepared.tenant_id = request.tenant_id
                AND prepared.batch_version = request.batch_version
                AND prepared.batch_id = request.batch_id
            WHERE prepared.stage_kind = 'metadata'
        ),
        selected_component_prepared_metadata AS (
            SELECT *
            FROM component_prepared_metadata_candidates
            QUALIFY
                row_number() OVER (
                    PARTITION BY tenant_id, batch_version, batch_id ORDER BY staged_at, stage_hash
                )
                = 1
        ),
        component_scope_metadata_candidates AS (
            SELECT scoped.*
            FROM identity_compaction_scope_stage AS scoped
            INNER JOIN
                selected_component_prepared_metadata AS metadata
                ON scoped.tenant_id = metadata.tenant_id
                AND scoped.batch_version = metadata.batch_version
                AND scoped.batch_id = metadata.batch_id
                AND scoped.input_hash = metadata.input_hash
            WHERE scoped.stage_kind = 'scope_metadata'
        ),
        selected_component_scope_metadata AS (
            SELECT *
            FROM component_scope_metadata_candidates
            QUALIFY
                row_number() OVER (
                    PARTITION BY tenant_id, batch_version, batch_id ORDER BY staged_at, stage_hash
                )
                = 1
        ),
        component_facts_metadata_candidates AS (
            SELECT scoped.*
            FROM identity_compaction_scope_stage AS scoped
            INNER JOIN
                selected_component_scope_metadata AS metadata
                ON scoped.tenant_id = metadata.tenant_id
                AND scoped.batch_version = metadata.batch_version
                AND scoped.batch_id = metadata.batch_id
                AND scoped.input_hash = metadata.input_hash
            WHERE scoped.stage_kind = 'facts_metadata'
        ),
        selected_component_facts_metadata AS (
            SELECT *
            FROM component_facts_metadata_candidates
            QUALIFY
                row_number() OVER (
                    PARTITION BY tenant_id, batch_version, batch_id ORDER BY staged_at, stage_hash
                )
                = 1
        ),
        selected_component_scope_rows AS (
            SELECT scoped.*
            FROM identity_compaction_scope_stage AS scoped
            INNER JOIN
                selected_component_scope_metadata AS metadata
                ON scoped.tenant_id = metadata.tenant_id
                AND scoped.batch_version = metadata.batch_version
                AND scoped.batch_id = metadata.batch_id
                AND scoped.input_hash = metadata.input_hash
            QUALIFY
                row_number() OVER (
                    PARTITION BY scoped.tenant_id, scoped.stage_kind, scoped.stage_key
                    ORDER BY scoped.staged_at, scoped.stage_hash
                )
                = 1
        ),
        identity_compaction_components_metadata AS (
            SELECT
                prepared.tenant_id AS tenant_id,
                prepared.batch_version AS batch_version,
                prepared.batch_id AS batch_id,
                prepared.staged_at AS staged_at,
                prepared.input_hash AS input_hash
            FROM selected_component_prepared_metadata AS prepared
            INNER JOIN
                selected_component_scope_metadata AS scoped
                ON prepared.tenant_id = scoped.tenant_id
                AND prepared.batch_version = scoped.batch_version
                AND prepared.batch_id = scoped.batch_id
                AND prepared.input_hash = scoped.input_hash
            INNER JOIN
                selected_component_facts_metadata AS facts
                ON prepared.tenant_id = facts.tenant_id
                AND prepared.batch_version = facts.batch_version
                AND prepared.batch_id = facts.batch_id
                AND prepared.input_hash = facts.input_hash
        ),
        component_retained_identity_facts AS (
            SELECT tenant_id, fact_kind, fact_key, fact_observed_at, fact_payload, evidence_keys
            FROM selected_component_scope_rows
            WHERE stage_kind = 'retained_fact'
        ),
        component_retained_identity_identifiers AS (
            SELECT
                facts.tenant_id AS tenant_id,
                facts.fact_kind AS fact_kind,
                facts.fact_key AS fact_key,
                facts.fact_observed_at AS fact_observed_at,
                facts.fact_payload AS fact_payload,
                identifier_key,
                substring(identifier_key, 1, position(identifier_key, ':') - 1) AS identifier_type,
                substring(identifier_key, position(identifier_key, ':') + 1) AS identifier_value,
                multiIf(
                    startsWith(identifier_key, 'email:'),
                    toUInt8(1),
                    startsWith(identifier_key, 'canonical_email:'),
                    toUInt8(2),
                    startsWith(identifier_key, 'user_id:'),
                    toUInt8(3),
                    startsWith(identifier_key, 'anonymous_id:'),
                    toUInt8(4),
                    toUInt8(5)
                ) AS winner_priority
            FROM component_retained_identity_facts AS facts ARRAY
            JOIN facts.evidence_keys AS identifier_key
            WHERE position(identifier_key, ':') > 1
        ),
        component_retained_fact_anchors AS (
            SELECT tenant_id, fact_kind, fact_key, min(identifier_key) AS anchor_identifier_key
            FROM component_retained_identity_identifiers
            GROUP BY tenant_id, fact_kind, fact_key
        ),
        component_retained_identifier_edges AS (
            SELECT DISTINCT
                identifiers.tenant_id AS tenant_id,
                least(anchors.anchor_identifier_key, identifiers.identifier_key) AS left_identifier_key,
                greatest(
                    anchors.anchor_identifier_key, identifiers.identifier_key
                ) AS right_identifier_key
            FROM component_retained_identity_identifiers AS identifiers
            INNER JOIN
                component_retained_fact_anchors AS anchors
                ON identifiers.tenant_id = anchors.tenant_id
                AND identifiers.fact_kind = anchors.fact_kind
                AND identifiers.fact_key = anchors.fact_key
            WHERE anchors.anchor_identifier_key != identifiers.identifier_key
        ),
        packed_identity_component_graph AS (
            SELECT
                nodes.tenant_id AS tenant_id,
                nodes.identifier_nodes AS identifier_nodes,
                coalesce(
                    edges.identifier_edges, CAST([], 'Array(Tuple(String, String))')
                ) AS identifier_edges,
                arrayEnumerate(nodes.identifier_nodes) AS initial_labels
            FROM
                (
                    SELECT tenant_id, arraySort(groupUniqArray(identifier_key)) AS identifier_nodes
                    FROM component_retained_identity_identifiers
                    GROUP BY tenant_id
                ) AS nodes
            LEFT JOIN
                (
                    SELECT
                        tenant_id,
                        arraySort(
                            groupUniqArray(tuple(left_identifier_key, right_identifier_key))
                        ) AS identifier_edges
                    FROM component_retained_identifier_edges
                    GROUP BY tenant_id
                ) AS edges
                ON nodes.tenant_id = edges.tenant_id
        ),
        folded_identity_component_graph AS (
            SELECT
                tenant_id,
                identifier_nodes,
                arrayFold(
                    (labels, edge) -> if(
                        labels[indexOf(identifier_nodes, tupleElement(edge, 1))]
                        = labels[indexOf(identifier_nodes, tupleElement(edge, 2))],
                        labels,
                        arrayMap(
                            label -> if(
                                label = greatest(
                                    labels[indexOf(identifier_nodes, tupleElement(edge, 1))],
                                    labels[indexOf(identifier_nodes, tupleElement(edge, 2))]
                                ),
                                least(
                                    labels[indexOf(identifier_nodes, tupleElement(edge, 1))],
                                    labels[indexOf(identifier_nodes, tupleElement(edge, 2))]
                                ),
                                label
                            ),
                            labels
                        )
                    ),
                    identifier_edges,
                    initial_labels
                ) AS final_labels
            FROM packed_identity_component_graph
        ),
        staged_identity_component_labels AS (
            SELECT
                tenant_id,
                tupleElement(member, 1) AS identifier_key,
                tupleElement(member, 2) AS component_label
            FROM folded_identity_component_graph ARRAY
            JOIN arrayZip(identifier_nodes, final_labels) AS member
        ),
        staged_identity_identifier_observations AS (
            SELECT
                identifiers.tenant_id AS tenant_id,
                identifiers.identifier_type AS identifier_type,
                identifiers.identifier_value AS identifier_value,
                identifiers.identifier_key AS identifier_key,
                identifiers.winner_priority AS winner_priority,
                min(identifiers.fact_observed_at) AS first_seen_at,
                max(identifiers.fact_observed_at) AS last_seen_at,
                argMaxIf(
                    JSONExtractString(identifiers.fact_payload, 'first_name'),
                    tuple(identifiers.fact_observed_at, identifiers.fact_key),
                    JSONExtractString(identifiers.fact_payload, 'first_name') != ''
                ) AS first_name,
                argMaxIf(
                    JSONExtractString(identifiers.fact_payload, 'last_name'),
                    tuple(identifiers.fact_observed_at, identifiers.fact_key),
                    JSONExtractString(identifiers.fact_payload, 'last_name') != ''
                ) AS last_name,
                max(identifiers.fact_observed_at) AS name_observed_at
            FROM component_retained_identity_identifiers AS identifiers
            GROUP BY
                identifiers.tenant_id,
                identifiers.identifier_type,
                identifiers.identifier_value,
                identifiers.identifier_key,
                identifiers.winner_priority
        ),
        staged_identity_component_members AS (
            SELECT
                labels.tenant_id AS tenant_id,
                toUInt64(labels.component_label) AS component_label,
                observations.identifier_type AS identifier_type,
                observations.identifier_value AS identifier_value,
                observations.identifier_key AS identifier_key,
                observations.winner_priority AS winner_priority,
                observations.first_seen_at AS first_seen_at,
                observations.last_seen_at AS last_seen_at,
                observations.first_name AS first_name,
                observations.last_name AS last_name,
                observations.name_observed_at AS name_observed_at
            FROM staged_identity_component_labels AS labels
            INNER JOIN
                staged_identity_identifier_observations AS observations
                ON labels.tenant_id = observations.tenant_id
                AND labels.identifier_key = observations.identifier_key
        ),
        identity_component_metadata_stage_rows AS (
            SELECT
                metadata.tenant_id AS tenant_id,
                metadata.batch_version AS batch_version,
                metadata.batch_id AS batch_id,
                'component_metadata' AS stage_kind,
                'component_metadata' AS stage_key,
                metadata.staged_at AS staged_at,
                lower(
                    hex(SHA256(concat('components:', metadata.batch_id, ':', metadata.input_hash)))
                ) AS stage_hash,
                metadata.input_hash AS input_hash,
                toUInt64(0) AS component_label,
                '' AS identifier_type,
                '' AS identifier_value,
                '' AS identifier_key,
                toUInt8(0) AS winner_priority,
                toDateTime64(0, 6) AS first_seen_at,
                toDateTime64(0, 6) AS last_seen_at,
                '' AS first_name,
                '' AS last_name,
                toDateTime64(0, 6) AS name_observed_at
            FROM identity_compaction_components_metadata AS metadata
        ),
        identity_component_member_stage_rows AS (
            SELECT
                members.tenant_id AS tenant_id,
                metadata.batch_version AS batch_version,
                metadata.batch_id AS batch_id,
                'component_member' AS stage_kind,
                members.identifier_key AS stage_key,
                metadata.staged_at AS staged_at,
                lower(
                    hex(
                        SHA256(
                            concat(
                                'component_member:',
                                metadata.input_hash,
                                ':',
                                toString(members.component_label),
                                ':',
                                toString(length(members.identifier_key)),
                                ':',
                                members.identifier_key,
                                ':',
                                toString(members.winner_priority),
                                ':',
                                toString(members.first_seen_at),
                                ':',
                                toString(members.last_seen_at),
                                ':',
                                members.first_name,
                                ':',
                                members.last_name,
                                ':',
                                toString(members.name_observed_at)
                            )
                        )
                    )
                ) AS stage_hash,
                metadata.input_hash AS input_hash,
                members.component_label AS component_label,
                members.identifier_type AS identifier_type,
                members.identifier_value AS identifier_value,
                members.identifier_key AS identifier_key,
                members.winner_priority AS winner_priority,
                members.first_seen_at AS first_seen_at,
                members.last_seen_at AS last_seen_at,
                members.first_name AS first_name,
                members.last_name AS last_name,
                members.name_observed_at AS name_observed_at
            FROM staged_identity_component_members AS members
            INNER JOIN
                identity_compaction_components_metadata AS metadata
                ON members.tenant_id = metadata.tenant_id
        )
    SELECT
        * REPLACE(
            CAST(stage_hash AS FixedString(64)) AS stage_hash,
            CAST(input_hash AS FixedString(64)) AS input_hash
        )
    FROM
        (
            SELECT *
            FROM identity_component_metadata_stage_rows
            UNION ALL
            SELECT *
            FROM identity_component_member_stage_rows
        )

DESCRIPTION >
    Daily first-, last-, and 40/20/40 conversion metrics, including paid-ad-only weights.

NODE multi_touch_conversion_rows
SQL >
    SELECT
        toDate(
            assumeNotNull(coalesce(session_start_timestamp, conversion_time)),
            'America/Los_Angeles'
        ) AS click_date,
        source,
        medium,
        ad_source_key,
        utm_campaign,
        campaign_id,
        adset_id,
        ad_id,
        coalesce(utm_content, 'unknown') AS utm_content,
        coalesce(utm_term, 'unknown') AS utm_term,
        coalesce(landing_page_host, 'offline') AS landing_page_host,
        coalesce(landing_page_path, 'offline') AS landing_page_path,
        uniqExactIf(assumeNotNull(session_id), session_id IS NOT NULL) AS sessions,
        sum(form_submissions_server_side * multi_touch_weight) AS form_submissions_server_side_mt,
        sum(form_submissions_server_side * first_touch_weight) AS form_submissions_server_side_ft,
        sum(form_submissions_server_side * last_touch_weight) AS form_submissions_server_side_lt,
        sum(form_submissions_server_side * paid_multi_touch_weight) AS form_submissions_server_side_paid_mt,
        sum(form_submissions_server_side * paid_first_touch_weight) AS form_submissions_server_side_paid_ft,
        sum(form_submissions_server_side * paid_last_touch_weight) AS form_submissions_server_side_paid_lt,
        sum(krc_registrations_server_side * multi_touch_weight) AS krc_registrations_server_side_mt,
        sum(krc_registrations_server_side * first_touch_weight) AS krc_registrations_server_side_ft,
        sum(krc_registrations_server_side * last_touch_weight) AS krc_registrations_server_side_lt,
        sum(krc_registrations_server_side * paid_multi_touch_weight) AS krc_registrations_server_side_paid_mt,
        sum(krc_registrations_server_side * paid_first_touch_weight) AS krc_registrations_server_side_paid_ft,
        sum(krc_registrations_server_side * paid_last_touch_weight) AS krc_registrations_server_side_paid_lt,
        sum(form_submissions_client_side * multi_touch_weight) AS form_submissions_client_side_mt,
        sum(form_submissions_client_side * first_touch_weight) AS form_submissions_client_side_ft,
        sum(form_submissions_client_side * last_touch_weight) AS form_submissions_client_side_lt,
        sum(form_submissions_client_side * paid_multi_touch_weight) AS form_submissions_client_side_paid_mt,
        sum(form_submissions_client_side * paid_first_touch_weight) AS form_submissions_client_side_paid_ft,
        sum(form_submissions_client_side * paid_last_touch_weight) AS form_submissions_client_side_paid_lt,
        sum(order_completed_server_side * multi_touch_weight) AS order_completed_server_side_mt,
        sum(order_completed_server_side * first_touch_weight) AS order_completed_server_side_ft,
        sum(order_completed_server_side * last_touch_weight) AS order_completed_server_side_lt,
        sum(order_completed_server_side * paid_multi_touch_weight) AS order_completed_server_side_paid_mt,
        sum(order_completed_server_side * paid_first_touch_weight) AS order_completed_server_side_paid_ft,
        sum(order_completed_server_side * paid_last_touch_weight) AS order_completed_server_side_paid_lt,
        sum(order_completed_client_side * multi_touch_weight) AS order_completed_client_side_mt,
        sum(order_completed_client_side * first_touch_weight) AS order_completed_client_side_ft,
        sum(order_completed_client_side * last_touch_weight) AS order_completed_client_side_lt,
        sum(order_completed_client_side * paid_multi_touch_weight) AS order_completed_client_side_paid_mt,
        sum(order_completed_client_side * paid_first_touch_weight) AS order_completed_client_side_paid_ft,
        sum(order_completed_client_side * paid_last_touch_weight) AS order_completed_client_side_paid_lt,
        sum(payments_server_side * multi_touch_weight) AS payments_server_side_mt,
        sum(payments_server_side * first_touch_weight) AS payments_server_side_ft,
        sum(payments_server_side * last_touch_weight) AS payments_server_side_lt,
        sum(payments_server_side * paid_multi_touch_weight) AS payments_server_side_paid_mt,
        sum(payments_server_side * paid_first_touch_weight) AS payments_server_side_paid_ft,
        sum(payments_server_side * paid_last_touch_weight) AS payments_server_side_paid_lt,
        sum(payments_client_side * multi_touch_weight) AS payments_client_side_mt,
        sum(payments_client_side * first_touch_weight) AS payments_client_side_ft,
        sum(payments_client_side * last_touch_weight) AS payments_client_side_lt,
        sum(payments_client_side * paid_multi_touch_weight) AS payments_client_side_paid_mt,
        sum(payments_client_side * paid_first_touch_weight) AS payments_client_side_paid_ft,
        sum(payments_client_side * paid_last_touch_weight) AS payments_client_side_paid_lt,
        sum(revenue_server_side * multi_touch_weight) AS revenue_server_side_mt,
        sum(revenue_server_side * first_touch_weight) AS revenue_server_side_ft,
        sum(revenue_server_side * last_touch_weight) AS revenue_server_side_lt,
        sum(revenue_server_side * paid_multi_touch_weight) AS revenue_server_side_paid_mt,
        sum(revenue_server_side * paid_first_touch_weight) AS revenue_server_side_paid_ft,
        sum(revenue_server_side * paid_last_touch_weight) AS revenue_server_side_paid_lt,
        sum(revenue_client_side * multi_touch_weight) AS revenue_client_side_mt,
        sum(revenue_client_side * first_touch_weight) AS revenue_client_side_ft,
        sum(revenue_client_side * last_touch_weight) AS revenue_client_side_lt,
        sum(revenue_client_side * paid_multi_touch_weight) AS revenue_client_side_paid_mt,
        sum(revenue_client_side * paid_first_touch_weight) AS revenue_client_side_paid_ft,
        sum(revenue_client_side * paid_last_touch_weight) AS revenue_client_side_paid_lt,
        sum(customers_server_side * multi_touch_weight) AS customers_server_side_mt,
        sum(customers_server_side * first_touch_weight) AS customers_server_side_ft,
        sum(customers_server_side * last_touch_weight) AS customers_server_side_lt,
        sum(customers_server_side * paid_multi_touch_weight) AS customers_server_side_paid_mt,
        sum(customers_server_side * paid_first_touch_weight) AS customers_server_side_paid_ft,
        sum(customers_server_side * paid_last_touch_weight) AS customers_server_side_paid_lt,
        sum(bbb_buyers_server_side * multi_touch_weight) AS bbb_buyers_server_side_mt,
        sum(bbb_buyers_server_side * first_touch_weight) AS bbb_buyers_server_side_ft,
        sum(bbb_buyers_server_side * last_touch_weight) AS bbb_buyers_server_side_lt,
        sum(bbb_buyers_server_side * paid_multi_touch_weight) AS bbb_buyers_server_side_paid_mt,
        sum(bbb_buyers_server_side * paid_first_touch_weight) AS bbb_buyers_server_side_paid_ft,
        sum(bbb_buyers_server_side * paid_last_touch_weight) AS bbb_buyers_server_side_paid_lt,
        sum(bbb_revenue_server_side * multi_touch_weight) AS bbb_revenue_server_side_mt,
        sum(bbb_revenue_server_side * first_touch_weight) AS bbb_revenue_server_side_ft,
        sum(bbb_revenue_server_side * last_touch_weight) AS bbb_revenue_server_side_lt,
        sum(bbb_revenue_server_side * paid_multi_touch_weight) AS bbb_revenue_server_side_paid_mt,
        sum(bbb_revenue_server_side * paid_first_touch_weight) AS bbb_revenue_server_side_paid_ft,
        sum(bbb_revenue_server_side * paid_last_touch_weight) AS bbb_revenue_server_side_paid_lt,
        sum(payments_vip_server_side * multi_touch_weight) AS payments_vip_server_side_mt,
        sum(payments_vip_server_side * first_touch_weight) AS payments_vip_server_side_ft,
        sum(payments_vip_server_side * last_touch_weight) AS payments_vip_server_side_lt,
        sum(payments_vip_server_side * paid_multi_touch_weight) AS payments_vip_server_side_paid_mt,
        sum(payments_vip_server_side * paid_first_touch_weight) AS payments_vip_server_side_paid_ft,
        sum(payments_vip_server_side * paid_last_touch_weight) AS payments_vip_server_side_paid_lt,
        sum(payments_book_server_side * multi_touch_weight) AS payments_book_server_side_mt,
        sum(payments_book_server_side * first_touch_weight) AS payments_book_server_side_ft,
        sum(payments_book_server_side * last_touch_weight) AS payments_book_server_side_lt,
        sum(payments_book_server_side * paid_multi_touch_weight) AS payments_book_server_side_paid_mt,
        sum(payments_book_server_side * paid_first_touch_weight) AS payments_book_server_side_paid_ft,
        sum(payments_book_server_side * paid_last_touch_weight) AS payments_book_server_side_paid_lt,
        sum(payments_mentorship_server_side * multi_touch_weight) AS payments_mentorship_server_side_mt,
        sum(payments_mentorship_server_side * first_touch_weight) AS payments_mentorship_server_side_ft,
        sum(payments_mentorship_server_side * last_touch_weight) AS payments_mentorship_server_side_lt,
        sum(payments_mentorship_server_side * paid_multi_touch_weight) AS payments_mentorship_server_side_paid_mt,
        sum(payments_mentorship_server_side * paid_first_touch_weight) AS payments_mentorship_server_side_paid_ft,
        sum(payments_mentorship_server_side * paid_last_touch_weight) AS payments_mentorship_server_side_paid_lt,
        sum(payments_kajabi_server_side * multi_touch_weight) AS payments_kajabi_server_side_mt,
        sum(payments_kajabi_server_side * first_touch_weight) AS payments_kajabi_server_side_ft,
        sum(payments_kajabi_server_side * last_touch_weight) AS payments_kajabi_server_side_lt,
        sum(payments_kajabi_server_side * paid_multi_touch_weight) AS payments_kajabi_server_side_paid_mt,
        sum(payments_kajabi_server_side * paid_first_touch_weight) AS payments_kajabi_server_side_paid_ft,
        sum(payments_kajabi_server_side * paid_last_touch_weight) AS payments_kajabi_server_side_paid_lt,
        sum(payments_catalog_server_side * multi_touch_weight) AS payments_catalog_server_side_mt,
        sum(payments_catalog_server_side * first_touch_weight) AS payments_catalog_server_side_ft,
        sum(payments_catalog_server_side * last_touch_weight) AS payments_catalog_server_side_lt,
        sum(payments_catalog_server_side * paid_multi_touch_weight) AS payments_catalog_server_side_paid_mt,
        sum(payments_catalog_server_side * paid_first_touch_weight) AS payments_catalog_server_side_paid_ft,
        sum(payments_catalog_server_side * paid_last_touch_weight) AS payments_catalog_server_side_paid_lt,
        sum(payments_unknown_server_side * multi_touch_weight) AS payments_unknown_server_side_mt,
        sum(payments_unknown_server_side * first_touch_weight) AS payments_unknown_server_side_ft,
        sum(payments_unknown_server_side * last_touch_weight) AS payments_unknown_server_side_lt,
        sum(payments_unknown_server_side * paid_multi_touch_weight) AS payments_unknown_server_side_paid_mt,
        sum(payments_unknown_server_side * paid_first_touch_weight) AS payments_unknown_server_side_paid_ft,
        sum(payments_unknown_server_side * paid_last_touch_weight) AS payments_unknown_server_side_paid_lt,
        sum(revenue_vip_server_side * multi_touch_weight) AS revenue_vip_server_side_mt,
        sum(revenue_vip_server_side * first_touch_weight) AS revenue_vip_server_side_ft,
        sum(revenue_vip_server_side * last_touch_weight) AS revenue_vip_server_side_lt,
        sum(revenue_vip_server_side * paid_multi_touch_weight) AS revenue_vip_server_side_paid_mt,
        sum(revenue_vip_server_side * paid_first_touch_weight) AS revenue_vip_server_side_paid_ft,
        sum(revenue_vip_server_side * paid_last_touch_weight) AS revenue_vip_server_side_paid_lt,
        sum(revenue_book_server_side * multi_touch_weight) AS revenue_book_server_side_mt,
        sum(revenue_book_server_side * first_touch_weight) AS revenue_book_server_side_ft,
        sum(revenue_book_server_side * last_touch_weight) AS revenue_book_server_side_lt,
        sum(revenue_book_server_side * paid_multi_touch_weight) AS revenue_book_server_side_paid_mt,
        sum(revenue_book_server_side * paid_first_touch_weight) AS revenue_book_server_side_paid_ft,
        sum(revenue_book_server_side * paid_last_touch_weight) AS revenue_book_server_side_paid_lt,
        sum(revenue_mentorship_server_side * multi_touch_weight) AS revenue_mentorship_server_side_mt,
        sum(revenue_mentorship_server_side * first_touch_weight) AS revenue_mentorship_server_side_ft,
        sum(revenue_mentorship_server_side * last_touch_weight) AS revenue_mentorship_server_side_lt,
        sum(revenue_mentorship_server_side * paid_multi_touch_weight) AS revenue_mentorship_server_side_paid_mt,
        sum(revenue_mentorship_server_side * paid_first_touch_weight) AS revenue_mentorship_server_side_paid_ft,
        sum(revenue_mentorship_server_side * paid_last_touch_weight) AS revenue_mentorship_server_side_paid_lt,
        sum(revenue_kajabi_server_side * multi_touch_weight) AS revenue_kajabi_server_side_mt,
        sum(revenue_kajabi_server_side * first_touch_weight) AS revenue_kajabi_server_side_ft,
        sum(revenue_kajabi_server_side * last_touch_weight) AS revenue_kajabi_server_side_lt,
        sum(revenue_kajabi_server_side * paid_multi_touch_weight) AS revenue_kajabi_server_side_paid_mt,
        sum(revenue_kajabi_server_side * paid_first_touch_weight) AS revenue_kajabi_server_side_paid_ft,
        sum(revenue_kajabi_server_side * paid_last_touch_weight) AS revenue_kajabi_server_side_paid_lt,
        sum(revenue_catalog_server_side * multi_touch_weight) AS revenue_catalog_server_side_mt,
        sum(revenue_catalog_server_side * first_touch_weight) AS revenue_catalog_server_side_ft,
        sum(revenue_catalog_server_side * last_touch_weight) AS revenue_catalog_server_side_lt,
        sum(revenue_catalog_server_side * paid_multi_touch_weight) AS revenue_catalog_server_side_paid_mt,
        sum(revenue_catalog_server_side * paid_first_touch_weight) AS revenue_catalog_server_side_paid_ft,
        sum(revenue_catalog_server_side * paid_last_touch_weight) AS revenue_catalog_server_side_paid_lt,
        sum(revenue_unknown_server_side * multi_touch_weight) AS revenue_unknown_server_side_mt,
        sum(revenue_unknown_server_side * first_touch_weight) AS revenue_unknown_server_side_ft,
        sum(revenue_unknown_server_side * last_touch_weight) AS revenue_unknown_server_side_lt,
        sum(revenue_unknown_server_side * paid_multi_touch_weight) AS revenue_unknown_server_side_paid_mt,
        sum(revenue_unknown_server_side * paid_first_touch_weight) AS revenue_unknown_server_side_paid_ft,
        sum(revenue_unknown_server_side * paid_last_touch_weight) AS revenue_unknown_server_side_paid_lt
    FROM reporting_current_journey_base_rows
    GROUP BY
        click_date,
        source,
        medium,
        ad_source_key,
        utm_campaign,
        campaign_id,
        adset_id,
        ad_id,
        utm_content,
        utm_term,
        landing_page_host,
        landing_page_path

NODE latest_multi_touch_ad_names
SQL >
    SELECT
        source AS ad_source,
        campaign_id AS name_campaign_id,
        adset_id AS name_adset_id,
        ad_id AS name_ad_id,
        campaign_name,
        adset_name,
        ad_name
    FROM reporting_latest_ad_names_current

NODE multi_touch_conversion_rows_with_ad_names
SQL >
    SELECT
        aggregated.click_date,
        aggregated.source,
        aggregated.medium,
        coalesce(names.campaign_name, aggregated.utm_campaign, 'unknown') AS campaign_name,
        coalesce(names.adset_name, 'unknown') AS adset_name,
        coalesce(names.ad_name, 'unknown') AS ad_name,
        aggregated.* EXCEPT (
            click_date,
            source,
            medium,
            ad_source_key,
            utm_campaign
        )
    FROM multi_touch_conversion_rows AS aggregated
    LEFT ANY JOIN latest_multi_touch_ad_names AS names
        ON names.ad_source = aggregated.ad_source_key
        AND isNotDistinctFrom(names.name_campaign_id, aggregated.campaign_id)
        AND isNotDistinctFrom(names.name_adset_id, aggregated.adset_id)
        AND isNotDistinctFrom(names.name_ad_id, aggregated.ad_id)

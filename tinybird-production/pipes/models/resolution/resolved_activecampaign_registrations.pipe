DESCRIPTION >
    ActiveCampaign registration rows resolved by normalized email, then normalized
    NANP phone, against the active identity generation.

NODE activecampaign_registration_phone_digits
SQL >
    SELECT
        registrations.*,
        replaceRegexpAll(trimBoth(ifNull(registrations.phone, '')), '[^0-9]', '') AS phone_digits
    FROM activecampaign_registration_adapter AS registrations

NODE activecampaign_registration_national_phones
SQL >
    SELECT
        *,
        multiIf(
            length(phone_digits) = 10,
            phone_digits,
            length(phone_digits) = 11 AND startsWith(phone_digits, '1'),
            substring(phone_digits, 2),
            ''
        ) AS national_phone
    FROM activecampaign_registration_phone_digits

NODE normalized_activecampaign_registration_identifiers
SQL >
    SELECT
        *,
        if(
            match(national_phone, '^[2-9][0-9]{2}[2-9][0-9]{6}$')
            AND substring(national_phone, 4, 3) != '555'
            AND NOT match(
                national_phone,
                '(0000000|1111111|2222222|3333333|4444444|5555555|6666666|7777777|8888888|9999999)$'
            )
            AND NOT match(national_phone, '^(0123456789|1234567890|234567890[0-9]|9876543210)$'),
            concat('+1', national_phone),
            CAST(NULL AS Nullable(String))
        ) AS normalized_phone
    FROM activecampaign_registration_national_phones

NODE resolved_activecampaign_registration_candidates
SQL >
    SELECT
        registrations.form_submission_id AS form_submission_id,
        registrations.submitted_at AS submitted_at,
        registrations.contact_id AS contact_id,
        registrations.email AS email,
        registrations.phone AS phone,
        registrations.first_name AS first_name,
        registrations.last_name AS last_name,
        registrations.full_name AS full_name,
        registrations.tag_id AS tag_id,
        registrations.tag_name AS tag_name,
        registrations.registration_type AS registration_type,
        registrations.content_name AS content_name,
        registrations.canonical_event_id AS canonical_event_id,
        registrations.form_type AS form_type,
        registrations.event_source AS event_source,
        registrations.registration_tag_type AS registration_tag_type,
        nullIf(identity_mapping.profile_id, '') AS profile_id
    FROM normalized_activecampaign_registration_identifiers AS registrations
    LEFT JOIN
        reporting_current_identity_mappings_direct AS identity_mapping
        ON identity_mapping.tenant_id = 'boom'
        AND identity_mapping.identifier_key = coalesce(
            if(
                registrations.email IS NULL,
                CAST(NULL AS Nullable(String)),
                concat('email:', registrations.email)
            ),
            if(
                registrations.normalized_phone IS NULL,
                CAST(NULL AS Nullable(String)),
                concat('phone:', registrations.normalized_phone)
            )
        )

NODE current_resolved_activecampaign_registrations
SQL >
    SELECT *
    FROM resolved_activecampaign_registration_candidates
    QUALIFY row_number() OVER (PARTITION BY form_submission_id ORDER BY profile_id ASC NULLS FIRST) = 1

DESCRIPTION >
    Compact reporting projection of the same activated mapping rows exposed by
    current_identity_mappings. Seed and delta rows are ranked together by state key.

NODE reporting_mapping_versions
SQL >
    SELECT
        tenant_id,
        state_key,
        is_deleted,
        identifier_type,
        identifier_value,
        identifier_key,
        profile_id,
        first_seen_at,
        last_seen_at,
        batch_version,
        committed_at,
        row_hash
    FROM identity_state_seed_enriched
    WHERE state_kind = 'mapping'
    UNION ALL
    SELECT
        journal.tenant_id,
        journal.state_key,
        journal.is_deleted,
        journal.identifier_type,
        journal.identifier_value,
        journal.identifier_key,
        journal.profile_id,
        journal.first_seen_at,
        journal.last_seen_at,
        journal.batch_version,
        journal.committed_at,
        journal.row_hash
    FROM identity_state_delta_versions AS journal
    INNER JOIN
        activated_identity_batches AS activated
        ON journal.tenant_id = activated.tenant_id
        AND journal.batch_version = activated.batch_version
        AND journal.batch_id = activated.batch_id
    WHERE journal.state_kind = 'mapping'

NODE reporting_current_mapping_rows
SQL >
    SELECT
        tenant_id,
        identifier_type,
        identifier_value,
        identifier_key,
        profile_id,
        first_seen_at,
        last_seen_at,
        batch_version,
        committed_at
    FROM reporting_mapping_versions
    QUALIFY
        row_number() OVER (
            PARTITION BY tenant_id, state_key
            ORDER BY batch_version DESC, committed_at DESC, row_hash DESC
        ) = 1
        AND is_deleted = 0

DESCRIPTION >
    Append-only canonical page-view versions. The reader
    resolves source precedence, revisions, and deletion tombstones at query time.

SCHEMA >
    `tenant_id` LowCardinality(String) `json:$.tenant_id`,
    `source_system` LowCardinality(String) `json:$.source_system`,
    `source_priority` UInt8 `json:$.source_priority`,
    `source_deleted` UInt8 `json:$.source_deleted`,
    `source_fact_version` UInt64 `json:$.source_fact_version`,
    `source_ingested_at` DateTime64(6) `json:$.source_ingested_at`,
    `payload_hash` FixedString(64) `json:$.payload_hash`,
    `page_view_id` Nullable(String) `json:$.page_view_id`,
    `anonymous_id` Nullable(String) `json:$.anonymous_id`,
    `user_id` Nullable(String) `json:$.user_id`,
    `page_view_timestamp` Nullable(DateTime64(6)) `json:$.page_view_timestamp`,
    `page_url` Nullable(String) `json:$.page_url`,
    `page_path` Nullable(String) `json:$.page_path`,
    `page_title` Nullable(String) `json:$.page_title`,
    `page_referrer` Nullable(String) `json:$.page_referrer`,
    `ip_address` Nullable(String) `json:$.ip_address`,
    `user_agent` Nullable(String) `json:$.user_agent`,
    `device_platform` Nullable(String) `json:$.device_platform`,
    `device_is_mobile` Nullable(Bool) `json:$.device_is_mobile`,
    `geo_city` Nullable(String) `json:$.geo_city`,
    `geo_region` Nullable(String) `json:$.geo_region`,
    `geo_region_code` Nullable(String) `json:$.geo_region_code`,
    `geo_country` Nullable(String) `json:$.geo_country`,
    `geo_timezone` Nullable(String) `json:$.geo_timezone`,
    `url_utm_source` Nullable(String) `json:$.url_utm_source`,
    `url_utm_medium` Nullable(String) `json:$.url_utm_medium`,
    `utm_campaign` Nullable(String) `json:$.utm_campaign`,
    `url_utm_campaign` Nullable(String) `json:$.url_utm_campaign`,
    `utm_content` Nullable(String) `json:$.utm_content`,
    `url_utm_content` Nullable(String) `json:$.url_utm_content`,
    `utm_term` Nullable(String) `json:$.utm_term`,
    `utm_id` Nullable(String) `json:$.utm_id`,
    `url_utm_id` Nullable(String) `json:$.url_utm_id`,
    `gclid` Nullable(String) `json:$.gclid`,
    `gbraid` Nullable(String) `json:$.gbraid`,
    `wbraid` Nullable(String) `json:$.wbraid`,
    `stored_fbclid` Nullable(String) `json:$.stored_fbclid`,
    `url_fbclid` Nullable(String) `json:$.url_fbclid`,
    `fbclid` Nullable(String) `json:$.fbclid`,
    `ttclid` Nullable(String) `json:$.ttclid`,
    `li_fat_id` Nullable(String) `json:$.li_fat_id`,
    `rdt_cid` Nullable(String) `json:$.rdt_cid`,
    `twclid` Nullable(String) `json:$.twclid`,
    `fbc` Nullable(String) `json:$.fbc`,
    `fbp` Nullable(String) `json:$.fbp`,
    `ttp` Nullable(String) `json:$.ttp`,
    `uetsid` Nullable(String) `json:$.uetsid`,
    `uetvid` Nullable(String) `json:$.uetvid`,
    `google_campaign_id` Nullable(String) `json:$.google_campaign_id`,
    `google_ad_group_id` Nullable(String) `json:$.google_ad_group_id`,
    `url_h_ad_id` Nullable(String) `json:$.url_h_ad_id`,
    `google_keyword_id` Nullable(String) `json:$.google_keyword_id`,
    `google_keyword` Nullable(String) `json:$.google_keyword`,
    `meta_adset_id` Nullable(String) `json:$.meta_adset_id`,
    `url_meta_adset_id` Nullable(String) `json:$.url_meta_adset_id`,
    `source_partition_time` Nullable(DateTime64(6)) `json:$.source_partition_time`,
    `page_host` Nullable(String) `json:$.page_host`,
    `page_referrer_host` Nullable(String) `json:$.page_referrer_host`,
    `utm_source` Nullable(String) `json:$.utm_source`,
    `is_identified_meta_ad_click` Nullable(UInt8) `json:$.is_identified_meta_ad_click`,
    `fbclid_observation_type` String `json:$.fbclid_observation_type`,
    `utm_medium` Nullable(String) `json:$.utm_medium`,
    `page_path_host` String `json:$.page_path_host`,
    `google_ad_id` Nullable(String) `json:$.google_ad_id`,
    `campaign_id` Nullable(String) `json:$.campaign_id`,
    `adset_id` Nullable(String) `json:$.adset_id`,
    `ad_id` Nullable(String) `json:$.ad_id`,
    `click_id` Nullable(String) `json:$.click_id`,
    `click_id_type` Nullable(String) `json:$.click_id_type`,
    `channel_source` Nullable(String) `json:$.channel_source`,
    `channel_medium` Nullable(String) `json:$.channel_medium`,
    `source_version` Nullable(DateTime64(6)) `json:$.source_version`,
    `__tb_state_key` String `json:$.__tb_state_key` DEFAULT ifNull(page_view_id, '')

ENGINE MergeTree
ENGINE_SORTING_KEY tenant_id, __tb_state_key, source_priority, source_fact_version, source_ingested_at, payload_hash

INDEXES >
    INDEX anonymous_id_bloom anonymous_id TYPE bloom_filter(0.01) GRANULARITY 1
    INDEX user_id_bloom user_id TYPE bloom_filter(0.01) GRANULARITY 1

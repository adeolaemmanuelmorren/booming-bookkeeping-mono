    `address_city` Nullable(String) `json:$.address_city`,
    `address_country` Nullable(String) `json:$.address_country`,
    `address_line_1` Nullable(String) `json:$.address_line_1`,
    `address_line_2` Nullable(String) `json:$.address_line_2`,
    `address_postal_code` Nullable(String) `json:$.address_postal_code`,
    `address_state` Nullable(String) `json:$.address_state`,
    `name` Nullable(String) `json:$.name`,
    `bank_account_id` Nullable(String) `json:$.bank_account_id`,
    `source_id` Nullable(String) `json:$.source_id`,
    `default_card_id` Nullable(String) `json:$.default_card_id`,
    `delinquent` Nullable(Bool) `json:$.delinquent`,
    `description` Nullable(String) `json:$.description`,
    `email` Nullable(String) `json:$.email`,
    `phone` Nullable(String) `json:$.phone`,
    `invoice_prefix` Nullable(String) `json:$.invoice_prefix`,
    `next_invoice_sequence` Nullable(Int64) `json:$.next_invoice_sequence`,
    `invoice_settings_default_payment_method` Nullable(String) `json:$.invoice_settings_default_payment_method`,
    `invoice_settings_footer` Nullable(String) `json:$.invoice_settings_footer`,
    `livemode` Nullable(Bool) `json:$.livemode`,
    `metadata` Nullable(String) `json:$.metadata`,
    `shipping_address_city` Nullable(String) `json:$.shipping_address_city`,
    `shipping_address_country` Nullable(String) `json:$.shipping_address_country`,
    `shipping_address_line_1` Nullable(String) `json:$.shipping_address_line_1`,
    `shipping_address_line_2` Nullable(String) `json:$.shipping_address_line_2`,
    `shipping_address_postal_code` Nullable(String) `json:$.shipping_address_postal_code`,
    `shipping_address_state` Nullable(String) `json:$.shipping_address_state`,
    `shipping_carrier` Nullable(String) `json:$.shipping_carrier`,

DESCRIPTION >
    One-time seed of current historical and pre-existing live identify
    versions. It has no schedule and is safe to replay because readers deduplicate versions.

NODE backfill_identify_version_rows
SQL >
    SELECT
        tenant_id,
        source_system,
        multiIf(source_system = 'jitsu_data', toUInt8(2), toUInt8(1)) AS source_priority,
        toUInt8(0) AS source_deleted,
        toUInt64(
            greatest(toUnixTimestamp64Micro(ifNull(source_version, toDateTime64(0, 6))), 0)
        ) AS source_fact_version,
        ifNull(source_version, toDateTime64(0, 6)) AS source_ingested_at,
        CAST(
            hex(
                SHA256(
                    concat(
                        source_system,
                        '|',
                        ifNull(identify_id, ''),
                        '|',
                        toString(ifNull(source_version, toDateTime64(0, 6)))
                    )
                )
            ),
            'FixedString(64)'
        ) AS payload_hash,
        identify_id,
        anonymous_id,
        user_id,
        email,
        phone,
        identified_at,
        ip_address,
        user_agent,
        geo_city,
        geo_region,
        geo_country,
        source_version,
        ifNull(identify_id, '') AS __tb_state_key
    FROM jitsu_identifies_build
    WHERE source_system != 'jitsu_events_api'
    UNION ALL
    SELECT
        tenant_id,
        source_system,
        source_priority,
        source_deleted,
        source_fact_version,
        source_ingested_at,
        payload_hash,
        identify_id,
        anonymous_id,
        user_id,
        email,
        phone,
        identified_at,
        ip_address,
        user_agent,
        geo_city,
        geo_region,
        geo_country,
        source_version,
        __tb_state_key
    FROM jitsu_identifies_live_build

TYPE COPY
TARGET_DATASOURCE jitsu_identify_versions
COPY_MODE append

DESCRIPTION >
    Replaces the small ad-name dimension after the identity-independent ad mart refreshes.

NODE build_reporting_latest_ad_names
SQL >
    SELECT
        source,
        campaign_id,
        adset_id,
        ad_id,
        argMaxIf(campaign_name, time, campaign_name IS NOT NULL) AS campaign_name,
        argMaxIf(adset_name, time, adset_name IS NOT NULL) AS adset_name,
        argMaxIf(ad_name, time, ad_name IS NOT NULL) AS ad_name,
        ifNull(campaign_id, '') AS __tb_sort_campaign_id,
        ifNull(adset_id, '') AS __tb_sort_adset_id,
        ifNull(ad_id, '') AS __tb_sort_ad_id
    FROM mart_ad_performance
    GROUP BY source, campaign_id, adset_id, ad_id

TYPE COPY
TARGET_DATASOURCE reporting_latest_ad_names_current
COPY_MODE replace

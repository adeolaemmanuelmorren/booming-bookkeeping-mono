DESCRIPTION >
    Project every arriving ActiveCampaign contact version into the reusable current
    state table.

NODE project_activecampaign_contact_versions
SQL >
    SELECT
        ifNull(id, toInt64(0)) AS contact_id,
        email,
        phone,
        first_name,
        last_name,
        created_utc_timestamp AS contact_created_at,
        ifNull(_fivetran_synced, toDateTime64(0, 6)) AS source_version,
        toUInt8(coalesce(_fivetran_deleted, false)) AS is_deleted
    FROM raw_activecampaign_contact

TYPE MATERIALIZED
DATASOURCE activecampaign_contacts_current

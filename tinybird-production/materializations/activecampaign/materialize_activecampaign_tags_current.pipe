DESCRIPTION >
    Project every arriving ActiveCampaign tag version into the reusable current
    state table.

NODE project_activecampaign_tag_versions
SQL >
    SELECT
        ifNull(id, '') AS tag_id,
        tags AS tag_name,
        c_date AS tag_created_at,
        ifNull(_fivetran_synced, toDateTime64(0, 6)) AS source_version,
        toUInt8(coalesce(_fivetran_deleted, false)) AS is_deleted
    FROM raw_activecampaign_tags

TYPE MATERIALIZED
DATASOURCE activecampaign_tags_current

DESCRIPTION >
    Project every arriving ActiveCampaign contact-tag version into the reusable
    current state table.

NODE project_activecampaign_contact_tag_versions
SQL >
    SELECT
        ifNull(id, toInt64(0)) AS contact_tag_id,
        contact AS contact_id,
        tags AS tag_id,
        c_date AS assigned_at,
        ifNull(_fivetran_synced, toDateTime64(0, 6)) AS source_version,
        toUInt8(coalesce(_fivetran_deleted, false)) AS is_deleted
    FROM raw_activecampaign_contact_tag

TYPE MATERIALIZED
DATASOURCE activecampaign_contact_tags_current

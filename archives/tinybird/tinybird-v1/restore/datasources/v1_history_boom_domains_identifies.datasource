    `source_partition_time` DateTime64(6) `json:$.source_partition_time`,
    `__tb_sort_1` String `json:$.__tb_sort_1` DEFAULT ifNull(id, ''),
    `__tb_sort_2` DateTime64(6) `json:$.__tb_sort_2` DEFAULT ifNull(timestamp, toDateTime64(0, 6))

ENGINE "MergeTree"
ENGINE_SORTING_KEY "__tb_sort_1, __tb_sort_2"

IMPORT_CONNECTION_NAME v1_history_gcs
IMPORT_BUCKET_URI gs://booming-data/tinybird/v1-preserved/history/raw_boom_domains_identifies/*.parquet
IMPORT_SCHEDULE '@on-demand'
IMPORT_FORMAT parquet

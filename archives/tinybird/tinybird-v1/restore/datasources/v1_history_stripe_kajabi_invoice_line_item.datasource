DESCRIPTION >
    Preserved source records for the one-time V1 history restore.

SCHEMA >
    `invoice_id` Nullable(String) `json:$.invoice_id`,
    `unique_id` Nullable(String) `json:$.unique_id`,
    `id` Nullable(String) `json:$.id`,
    `amount` Nullable(Int64) `json:$.amount`,
    `amount_excluding_tax` Nullable(Int64) `json:$.amount_excluding_tax`,
    `currency` Nullable(String) `json:$.currency`,
    `description` Nullable(String) `json:$.description`,
    `discountable` Nullable(Bool) `json:$.discountable`,
    `livemode` Nullable(Bool) `json:$.livemode`,
    `metadata` Nullable(String) `json:$.metadata`,
    `period_start` Nullable(DateTime64(6)) `json:$.period_start`,
    `period_end` Nullable(DateTime64(6)) `json:$.period_end`,
    `proration` Nullable(Bool) `json:$.proration`,
    `quantity` Nullable(Int64) `json:$.quantity`,
    `type` Nullable(String) `json:$.type`,
    `unit_amount_excluding_tax` Nullable(String) `json:$.unit_amount_excluding_tax`,
    `price_id` Nullable(String) `json:$.price_id`,
    `plan_id` Nullable(String) `json:$.plan_id`,
    `subscription_id` Nullable(String) `json:$.subscription_id`,
    `subscription_item_id` Nullable(String) `json:$.subscription_item_id`,
    `_fivetran_synced` Nullable(DateTime64(6)) `json:$._fivetran_synced`,
    `invoice_item_id` Nullable(String) `json:$.invoice_item_id`,
    `__tb_sort_1` String `json:$.__tb_sort_1` DEFAULT ifNull(invoice_id, ''),
    `__tb_sort_2` String `json:$.__tb_sort_2` DEFAULT ifNull(unique_id, ''),
    `__tb_sort_3` String `json:$.__tb_sort_3` DEFAULT ifNull(id, ''),
    `__tb_sort_4` DateTime64(6) `json:$.__tb_sort_4` DEFAULT ifNull(_fivetran_synced, toDateTime64(0, 6))

ENGINE "MergeTree"
ENGINE_SORTING_KEY "__tb_sort_1, __tb_sort_2, __tb_sort_3, __tb_sort_4"

IMPORT_CONNECTION_NAME v1_history_gcs
IMPORT_BUCKET_URI gs://booming-data/tinybird/v1-preserved/history/raw_stripe_kajabi_invoice_line_item/*.parquet
IMPORT_SCHEDULE '@on-demand'
IMPORT_FORMAT parquet

DESCRIPTION >
    Simple versioned identity output. Graph computed externally. Filter to a completed snapshot.

SCHEMA >
    `tenant_id` String `json:$.tenant_id`,
    `snapshot_id` String `json:$.snapshot_id`,
    `bucket` UInt16 `json:$.bucket`,
    `profile_id` String `json:$.profile_id`,
    `winner_identifier` String `json:$.winner_identifier`,
    `identifier_count` UInt64 `json:$.identifier_count`,
    `first_seen_at` Nullable(DateTime64(6)) `json:$.first_seen_at`,
    `last_seen_at` Nullable(DateTime64(6)) `json:$.last_seen_at`,
    `exported_at` DateTime64(3) `json:$.exported_at`,
    `row_hash` String `json:$.row_hash`

ENGINE MergeTree
ENGINE_SORTING_KEY tenant_id, snapshot_id, bucket, profile_id

TOKEN v1_facts_runtime READ
TOKEN v1_facts_runtime APPEND

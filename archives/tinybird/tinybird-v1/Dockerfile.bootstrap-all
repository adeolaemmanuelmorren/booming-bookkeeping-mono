FROM node:22-bookworm-slim
WORKDIR /app
COPY --chown=node:node package.json ./package.json
COPY --chown=node:node worker ./worker
COPY --chown=node:node scripts ./scripts
COPY --chown=node:node config ./config
COPY --chown=node:node build-manifest.json ./build-manifest.json
ENV NODE_OPTIONS=--max-old-space-size=8192
ENV BOOTSTRAP_CONFIG_PATH=/app/config/bootstrap.json
ENV BOOTSTRAP_SINGLE_TASK=1
ENV BOOTSTRAP_RUNNER_REGION=us-east4
USER node
CMD ["node", "--experimental-strip-types", "scripts/bootstrap-all.ts"]

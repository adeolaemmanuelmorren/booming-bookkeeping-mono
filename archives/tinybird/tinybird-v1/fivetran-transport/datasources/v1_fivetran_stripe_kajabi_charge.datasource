DESCRIPTION >
    Continuing raw Fivetran source records for V1.

SCHEMA >
    `id` Nullable(String) `json:$.id`,
    `connected_account_id` Nullable(String) `json:$.connected_account_id`,
    `amount` Nullable(Int64) `json:$.amount`,
    `amount_captured` Nullable(Int64) `json:$.amount_captured`,
    `amount_refunded` Nullable(Int64) `json:$.amount_refunded`,
    `application` Nullable(String) `json:$.application`,
    `billing_detail_address_city` Nullable(String) `json:$.billing_detail_address_city`,
    `billing_detail_address_country` Nullable(String) `json:$.billing_detail_address_country`,
    `billing_detail_address_line_1` Nullable(String) `json:$.billing_detail_address_line_1`,
    `billing_detail_address_line_2` Nullable(String) `json:$.billing_detail_address_line_2`,
    `billing_detail_address_postal_code` Nullable(String) `json:$.billing_detail_address_postal_code`,
    `billing_detail_address_state` Nullable(String) `json:$.billing_detail_address_state`,
    `billing_detail_email` Nullable(String) `json:$.billing_detail_email`,
    `billing_detail_name` Nullable(String) `json:$.billing_detail_name`,
    `billing_detail_phone` Nullable(String) `json:$.billing_detail_phone`,
    `application_fee_amount` Nullable(Int64) `json:$.application_fee_amount`,
    `calculated_statement_descriptor` Nullable(String) `json:$.calculated_statement_descriptor`,
    `captured` Nullable(Bool) `json:$.captured`,
    `created` Nullable(DateTime64(6)) `json:$.created`,
    `currency` Nullable(String) `json:$.currency`,
    `description` Nullable(String) `json:$.description`,
    `destination` Nullable(String) `json:$.destination`,
    `failure_code` Nullable(String) `json:$.failure_code`,
    `failure_message` Nullable(String) `json:$.failure_message`,
    `fraud_details_user_report` Nullable(String) `json:$.fraud_details_user_report`,
    `fraud_details_stripe_report` Nullable(String) `json:$.fraud_details_stripe_report`,
    `livemode` Nullable(Bool) `json:$.livemode`,
    `metadata` Nullable(String) `json:$.metadata`,
    `on_behalf_of` Nullable(String) `json:$.on_behalf_of`,
    `outcome_network_decline_code` Nullable(String) `json:$.outcome_network_decline_code`,
    `outcome_network_status` Nullable(String) `json:$.outcome_network_status`,
    `outcome_reason` Nullable(String) `json:$.outcome_reason`,
    `outcome_risk_level` Nullable(String) `json:$.outcome_risk_level`,
    `outcome_risk_score` Nullable(Int64) `json:$.outcome_risk_score`,
    `outcome_seller_message` Nullable(String) `json:$.outcome_seller_message`,
    `outcome_type` Nullable(String) `json:$.outcome_type`,
    `paid` Nullable(Bool) `json:$.paid`,
    `receipt_email` Nullable(String) `json:$.receipt_email`,
    `receipt_number` Nullable(String) `json:$.receipt_number`,
    `receipt_url` Nullable(String) `json:$.receipt_url`,
    `refunded` Nullable(Bool) `json:$.refunded`,
    `shipping_address_city` Nullable(String) `json:$.shipping_address_city`,
    `shipping_address_country` Nullable(String) `json:$.shipping_address_country`,
    `shipping_address_line_1` Nullable(String) `json:$.shipping_address_line_1`,
    `shipping_address_line_2` Nullable(String) `json:$.shipping_address_line_2`,
    `shipping_address_postal_code` Nullable(String) `json:$.shipping_address_postal_code`,
    `shipping_address_state` Nullable(String) `json:$.shipping_address_state`,
    `shipping_carrier` Nullable(String) `json:$.shipping_carrier`,
    `shipping_name` Nullable(String) `json:$.shipping_name`,
    `shipping_phone` Nullable(String) `json:$.shipping_phone`,
    `shipping_tracking_number` Nullable(String) `json:$.shipping_tracking_number`,
    `card_id` Nullable(String) `json:$.card_id`,
    `bank_account_id` Nullable(String) `json:$.bank_account_id`,
    `source_id` Nullable(String) `json:$.source_id`,
    `source_transfer` Nullable(String) `json:$.source_transfer`,
    `statement_descriptor` Nullable(String) `json:$.statement_descriptor`,
    `statement_descriptor_suffix` Nullable(String) `json:$.statement_descriptor_suffix`,
    `status` Nullable(String) `json:$.status`,
    `transfer_data_destination` Nullable(String) `json:$.transfer_data_destination`,
    `transfer_group` Nullable(String) `json:$.transfer_group`,
    `balance_transaction_id` Nullable(String) `json:$.balance_transaction_id`,
    `customer_id` Nullable(String) `json:$.customer_id`,
    `failure_balance_transaction_id` Nullable(String) `json:$.failure_balance_transaction_id`,
    `invoice_id` Nullable(String) `json:$.invoice_id`,
    `payment_intent_id` Nullable(String) `json:$.payment_intent_id`,
    `payment_method_id` Nullable(String) `json:$.payment_method_id`,
    `transfer_id` Nullable(String) `json:$.transfer_id`,
    `_fivetran_synced` Nullable(DateTime64(6)) `json:$._fivetran_synced`,
    `rule_rule` Nullable(String) `json:$.rule_rule`,
    `_v1_observed_at` DateTime64(6) `json:$._v1_observed_at`,
    `_v1_deleted` Bool `json:$._v1_deleted` DEFAULT 0,
    `_v1_observation_kind` LowCardinality(String) `json:$._v1_observation_kind`,
    `__tb_sort_1` String `json:$.__tb_sort_1` DEFAULT ifNull(id, ''),
    `__tb_sort_2` DateTime64(6) `json:$.__tb_sort_2` DEFAULT ifNull(_fivetran_synced, toDateTime64(0, 6))

ENGINE "MergeTree"
ENGINE_SORTING_KEY "__tb_sort_1, __tb_sort_2"

IMPORT_CONNECTION_NAME v1_history_gcs
IMPORT_BUCKET_URI gs://booming-data/tinybird/v1-live/raw_stripe_kajabi_charge/**/*.parquet
IMPORT_SCHEDULE '@on-demand'
IMPORT_FORMAT parquet

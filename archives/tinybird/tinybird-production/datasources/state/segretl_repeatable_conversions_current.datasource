    `click_ids` Tuple(gclid Nullable(String), wbraid Nullable(String), gbraid Nullable(String), fbclid Nullable(String), ttclid Nullable(String)) `json:$.click_ids`,
    `pre_conversion_fbc` Nullable(String) `json:$.pre_conversion_fbc`,

DESCRIPTION >
    Versioned current-state projection of ActiveCampaign contact-tag assignments.

SCHEMA >
    `contact_tag_id` Int64 `json:$.contact_tag_id`,
    `contact_id` Nullable(Int64) `json:$.contact_id`,
    `tag_id` Nullable(Int64) `json:$.tag_id`,
    `assigned_at` Nullable(DateTime64(6)) `json:$.assigned_at`,
    `source_version` DateTime64(6) `json:$.source_version`,
    `is_deleted` UInt8 `json:$.is_deleted`

ENGINE ReplacingMergeTree
ENGINE_SORTING_KEY contact_tag_id
ENGINE_VER source_version

DESCRIPTION >
    Visitors whose page views changed inside an ingestion window. The reporting
    facts coordinator re-sessionizes each returned visitor completely, so a
    visitor is identified the same way sessionization partitions them:
    anonymous_id first, else user_id, else the page view id itself.

NODE changed_page_view_visitors
SQL >
    %
    SELECT
        multiIf(
            anonymous_id IS NOT NULL,
            'anonymous',
            user_id IS NOT NULL,
            'user',
            'page_view'
        ) AS visitor_kind,
        assumeNotNull(coalesce(anonymous_id, user_id, page_view_id)) AS visitor_value,
        max(source_ingested_at) AS last_ingested_at
    FROM jitsu_page_view_versions
    WHERE tenant_id = 'boom'
        AND source_ingested_at
            > toDateTime64({{ String(p_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
        AND source_ingested_at
            <= toDateTime64({{ String(p_ingested_to, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY visitor_kind, visitor_value
    ORDER BY last_ingested_at ASC, visitor_kind ASC, visitor_value ASC
    LIMIT {{ UInt64(p_limit, 2000) }}

TYPE ENDPOINT

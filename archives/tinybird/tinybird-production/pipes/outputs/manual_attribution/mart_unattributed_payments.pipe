DESCRIPTION >
    Successful Stripe payments with no resolved profile after automatic and manual attribution.

NODE unattributed_payment_rows
SQL >
    SELECT
        payment_source AS payment_source,
        payment_id AS payment_id,
        payment_time AS payment_time,
        payment_date AS payment_date,
        customer_id AS customer_id,
        payment_email AS payment_email,
        payment_name AS payment_name,
        payment_phone AS payment_phone,
        billing_address_line_1 AS billing_address_line_1,
        billing_address_city AS billing_address_city,
        billing_address_region AS billing_address_region,
        billing_address_zip AS billing_address_zip,
        billing_address_country AS billing_address_country,
        currency AS currency,
        amount_paid AS amount_paid,
        refund_amount AS refund_amount,
        net_amount AS net_amount,
        has_refund AS has_refund,
        product_id AS product_id,
        product_name AS product_name,
        product_variant AS product_variant,
        price_id AS price_id,
        plan_id AS plan_id,
        product_rule AS product_rule,
        product_classification_method AS product_classification_method,
        is_product_classified AS is_product_classified,
        is_bbb_mentorship_installment AS is_bbb_mentorship_installment,
        payment_sequence_number AS payment_sequence_number,
        payment_occurrence_type AS payment_occurrence_type,
        is_repeat_payment AS is_repeat_payment,
        payment_intent_id AS payment_intent_id,
        payment_method_id AS payment_method_id,
        invoice_id AS invoice_id,
        subscription_id AS subscription_id,
        checkout_session_id AS checkout_session_id,
        payment_link_id AS payment_link_id,
        invoice_billing_reason AS invoice_billing_reason,
        checkout_mode AS checkout_mode,
        has_discount AS has_discount,
        discount_amount AS discount_amount,
        discount_ids AS discount_ids,
        coupon_ids AS coupon_ids,
        coupon_names AS coupon_names,
        promotion_code_ids AS promotion_code_ids,
        promotion_codes AS promotion_codes,
        coupon_amount_off AS coupon_amount_off,
        coupon_percent_off AS coupon_percent_off,
        charge_description AS charge_description,
        calculated_statement_descriptor AS calculated_statement_descriptor,
        statement_descriptor AS statement_descriptor,
        payment_intent_description AS payment_intent_description,
        invoice_description AS invoice_description,
        book_product_text AS book_product_text,
        receipt_url AS receipt_url,
        livemode AS livemode,
        product_complete_name AS product_complete_name,
        content_ids AS content_ids,
        automatic_profile_id AS automatic_profile_id,
        payment_category AS payment_category,
        manual_profile_id AS manual_profile_id,
        profile_id AS profile_id,
        attribution_method AS attribution_method,
        first_name AS first_name,
        last_name AS last_name,
        manual_link_created_at AS manual_link_created_at,
        manual_link_created_by AS manual_link_created_by
    FROM mart_payments
    WHERE profile_id IS NULL

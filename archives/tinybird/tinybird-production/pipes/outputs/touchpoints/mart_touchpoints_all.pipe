DESCRIPTION >
    Current session touchpoints with profile identity resolved at read time.

NODE current_touchpoint_rows
SQL >
    SELECT
        touchpoint_id,
        session_id,
        profile_id,
        visitor_key,
        anonymous_id,
        user_id,
        session_start_timestamp,
        touchpoint_time,
        session_end_timestamp,
        session_duration_seconds,
        page_view_count,
        first_page_view_id,
        first_page_url,
        first_page_host,
        first_page_path,
        first_page_path_host,
        ip_address,
        user_agent,
        device_platform,
        device_is_mobile,
        geo_city,
        geo_region,
        geo_region_code,
        geo_country,
        geo_timezone,
        last_page_view_id,
        last_page_url,
        last_page_path,
        utm_source,
        utm_medium,
        utm_campaign,
        utm_content,
        utm_term,
        utm_id,
        campaign_id,
        adset_id,
        ad_id,
        google_keyword_id,
        google_keyword,
        click_id,
        click_id_type,
        gclid,
        gbraid,
        wbraid,
        fbclid,
        fbc_fbclid,
        ttclid,
        li_fat_id,
        rdt_cid,
        twclid,
        fbc,
        fbp,
        ttp,
        uetsid,
        uetvid,
        channel_source,
        channel_medium,
        is_identified
    FROM resolved_session_touchpoint_facts

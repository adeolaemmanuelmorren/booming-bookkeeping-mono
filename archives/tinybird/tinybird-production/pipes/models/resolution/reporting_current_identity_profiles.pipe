DESCRIPTION >
    Compact reporting projection of the same activated profile rows exposed by
    current_identity_profiles. Seed and delta rows are ranked together by state key.

NODE reporting_profile_versions
SQL >
    SELECT
        tenant_id,
        state_key,
        is_deleted,
        profile_id,
        profile_key,
        winner_identifier_key,
        member_identifier_keys,
        anonymous_ids,
        user_ids,
        emails,
        phones,
        historical_profile_ids,
        first_name,
        last_name,
        first_seen_at,
        last_seen_at,
        batch_version,
        committed_at,
        row_hash
    FROM identity_state_seed_enriched
    WHERE state_kind = 'profile'
    UNION ALL
    SELECT
        journal.tenant_id,
        journal.state_key,
        journal.is_deleted,
        journal.profile_id,
        journal.profile_key,
        journal.winner_identifier_key,
        journal.member_identifier_keys,
        journal.anonymous_ids,
        journal.user_ids,
        journal.emails,
        journal.phones,
        journal.historical_profile_ids,
        journal.first_name,
        journal.last_name,
        journal.first_seen_at,
        journal.last_seen_at,
        journal.batch_version,
        journal.committed_at,
        journal.row_hash
    FROM identity_state_delta_versions AS journal
    INNER JOIN
        activated_identity_batches AS activated
        ON journal.tenant_id = activated.tenant_id
        AND journal.batch_version = activated.batch_version
        AND journal.batch_id = activated.batch_id
    WHERE journal.state_kind = 'profile'

NODE reporting_current_profile_rows
SQL >
    SELECT
        tenant_id,
        profile_id,
        profile_key,
        winner_identifier_key,
        member_identifier_keys,
        anonymous_ids,
        user_ids,
        emails,
        phones,
        historical_profile_ids,
        first_name,
        last_name,
        first_seen_at,
        last_seen_at,
        batch_version,
        committed_at
    FROM reporting_profile_versions
    QUALIFY
        row_number() OVER (
            PARTITION BY tenant_id, state_key
            ORDER BY batch_version DESC, committed_at DESC, row_hash DESC
        ) = 1
        AND is_deleted = 0

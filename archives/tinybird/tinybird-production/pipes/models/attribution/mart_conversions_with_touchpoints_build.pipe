DESCRIPTION >
    Fast current conversion journey reader backed by atomically committed rows.

NODE current_conversion_touchpoint_build_rows
SQL >
    SELECT
        journey.conversion_id,
        journey.profile_id,
        journey.conversion_time,
        journey.conversion_source,
        journey.conversion_type,
        journey.form_submissions_server_side,
        journey.krc_registrations_server_side,
        journey.form_submissions_client_side,
        journey.order_completed_server_side,
        journey.order_completed_client_side,
        journey.payments_server_side,
        journey.payments_client_side,
        journey.revenue_server_side,
        journey.revenue_client_side,
        journey.customers_server_side,
        journey.bbb_buyers_server_side,
        journey.bbb_revenue_server_side,
        journey.payments_vip_server_side,
        journey.payments_book_server_side,
        journey.payments_mentorship_server_side,
        journey.payments_kajabi_server_side,
        journey.payments_catalog_server_side,
        journey.payments_unknown_server_side,
        journey.revenue_vip_server_side,
        journey.revenue_book_server_side,
        journey.revenue_mentorship_server_side,
        journey.revenue_kajabi_server_side,
        journey.revenue_catalog_server_side,
        journey.revenue_unknown_server_side,
        journey.touchpoint_id,
        journey.session_id,
        journey.session_start_timestamp,
        journey.landing_page_host,
        journey.landing_page_path,
        journey.source,
        journey.medium,
        journey.utm_campaign,
        journey.utm_content,
        journey.utm_term,
        journey.campaign_id,
        journey.adset_id,
        journey.ad_id,
        journey.campaign_name,
        journey.adset_name,
        journey.ad_name,
        journey.is_direct_touch,
        journey.is_paid_ad_touch,
        journey.total_touchpoints,
        journey.touchpoint_number,
        journey.is_excluded_direct_touch,
        journey.non_direct_touchpoints,
        journey.non_direct_touchpoint_number,
        journey.attribution_touchpoints,
        journey.attribution_touchpoint_number,
        journey.first_touch_is_direct,
        journey.excluded_direct_touchpoints,
        journey.paid_ad_touchpoints,
        journey.paid_ad_touchpoint_number,
        journey.journey_direct_status,
        journey.multi_touch_weight,
        journey.first_touch_weight,
        journey.last_touch_weight,
        journey.paid_multi_touch_weight,
        journey.paid_first_touch_weight,
        journey.paid_last_touch_weight
    FROM reporting_current_journey_rows AS journey

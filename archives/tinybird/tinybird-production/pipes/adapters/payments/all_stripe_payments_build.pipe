DESCRIPTION >
    Common successful-payment contract across the primary and Kajabi Stripe
    accounts, including reusable normalized product-content identifiers.

NODE combined_stripe_payment_providers
SQL >
    SELECT
        payment_source,
        payment_id,
        payment_time,
        payment_date,
        customer_id,
        payment_email,
        payment_name,
        payment_phone,
        billing_address_line_1,
        billing_address_city,
        billing_address_region,
        billing_address_zip,
        billing_address_country,
        currency,
        amount_paid,
        refund_amount,
        net_amount,
        has_refund,
        product_id,
        product_name,
        product_variant,
        price_id,
        plan_id,
        product_rule,
        product_classification_method,
        is_product_classified,
        is_bbb_mentorship_installment,
        payment_sequence_number,
        payment_occurrence_type,
        is_repeat_payment,
        payment_intent_id,
        payment_method_id,
        invoice_id,
        subscription_id,
        checkout_session_id,
        payment_link_id,
        invoice_billing_reason,
        checkout_mode,
        has_discount,
        discount_amount,
        discount_ids,
        coupon_ids,
        coupon_names,
        promotion_code_ids,
        promotion_codes,
        coupon_amount_off,
        coupon_percent_off,
        charge_description,
        calculated_statement_descriptor,
        statement_descriptor,
        payment_intent_description,
        invoice_description,
        book_product_text,
        receipt_url,
        livemode,
        product_complete_name
    FROM stripe_primary_payment_adapter
    UNION ALL
    SELECT
        payment_source,
        payment_id,
        payment_time,
        payment_date,
        customer_id,
        payment_email,
        payment_name,
        payment_phone,
        billing_address_line_1,
        billing_address_city,
        billing_address_region,
        billing_address_zip,
        billing_address_country,
        currency,
        amount_paid,
        refund_amount,
        net_amount,
        has_refund,
        product_id,
        product_name,
        product_variant,
        price_id,
        plan_id,
        product_rule,
        product_classification_method,
        is_product_classified,
        is_bbb_mentorship_installment,
        payment_sequence_number,
        payment_occurrence_type,
        is_repeat_payment,
        payment_intent_id,
        payment_method_id,
        invoice_id,
        subscription_id,
        checkout_session_id,
        payment_link_id,
        invoice_billing_reason,
        checkout_mode,
        has_discount,
        discount_amount,
        discount_ids,
        coupon_ids,
        coupon_names,
        promotion_code_ids,
        promotion_codes,
        coupon_amount_off,
        coupon_percent_off,
        charge_description,
        calculated_statement_descriptor,
        statement_descriptor,
        payment_intent_description,
        invoice_description,
        book_product_text,
        receipt_url,
        livemode,
        product_complete_name
    FROM stripe_kajabi_payment_adapter

NODE normalized_stripe_payment_content
SQL >
    SELECT
        *,
        arrayFilter(
            normalized_name -> normalized_name != '',
            arrayMap(
                raw_name -> ifNull(
                    nullIf(
                        trim(
                            replaceRegexpAll(
                                lowerUTF8(
                                    replaceAll(
                                        replaceAll(
                                            replaceAll(
                                                replaceAll(
                                                    replaceAll(
                                                        replaceAll(
                                                            replaceAll(
                                                                raw_name, '__NUMERIC_COMMA__', ','
                                                            ),
                                                            '&amp;',
                                                            '&'
                                                        ),
                                                        '&quot;',
                                                        '"'
                                                    ),
                                                    '&#39;',
                                                    char(39)
                                                ),
                                                '&apos;',
                                                char(39)
                                            ),
                                            '&nbsp;',
                                            ' '
                                        ),
                                        '&#44;',
                                        ','
                                    )
                                ),
                                '\\s+',
                                ' '
                            )
                        ),
                        ''
                    ),
                    ''
                ),
                splitByChar(
                    ',',
                    replaceRegexpAll(
                        ifNull(product_complete_name, ''), '([0-9]),([0-9])', '\\1__NUMERIC_COMMA__\\2'
                    )
                )
            )
        ) AS content_ids
    FROM combined_stripe_payment_providers

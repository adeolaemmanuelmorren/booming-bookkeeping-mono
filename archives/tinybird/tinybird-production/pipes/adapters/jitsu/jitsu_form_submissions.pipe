DESCRIPTION >
    Current form-submission contract over physical version state.

NODE recently_ingested_form_submission_keys
SQL >
    %
    SELECT tenant_id, __tb_state_key
    FROM jitsu_form_submission_versions
    WHERE
        {{ String(p_identity_producer, 'all') }} = 'source_identity:segment_form'
        AND __tb_state_key != ''
        AND source_ingested_at
        >= toDateTime64({{ String(p_source_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY tenant_id, __tb_state_key

NODE ranked_form_submission_versions
SQL >
    %
    SELECT
        source.*,
        row_number() OVER (
            PARTITION BY source.tenant_id, source.form_submission_id
            ORDER BY
                source.source_priority DESC,
                source.source_fact_version DESC,
                source.source_ingested_at DESC,
                source.payload_hash DESC
        ) AS current_version_rank
    FROM jitsu_form_submission_versions AS source
    WHERE
        {{ String(p_identity_producer, 'all') }} = 'all'
        OR (
            {{ String(p_identity_producer, 'all') }} = 'source_identity:segment_form'
            AND (source.tenant_id, source.__tb_state_key)
            IN (SELECT tenant_id, __tb_state_key FROM recently_ingested_form_submission_keys)
        )

NODE current_form_submission_rows
SQL >
    SELECT
        tenant_id,
        form_submission_id,
        source_system,
        event_id,
        submitted_at,
        anonymous_id,
        user_id,
        email,
        phone,
        first_name,
        checkout_member_name,
        form_id,
        form_name,
        form_action,
        form_method,
        page_url,
        page_path,
        page_referrer,
        ip_address,
        user_agent,
        geo_city,
        geo_region,
        geo_country,
        stripe_payment_method_id,
        payment_method_type,
        payment_provider,
        payment_type,
        coupon,
        gclid,
        gbraid,
        fbclid,
        fbc,
        fbp,
        ttp,
        uetsid,
        uetvid,
        utm_source,
        utm_medium,
        utm_campaign,
        utm_content,
        utm_term,
        active_campaign_form_id,
        registration_type,
        content_name,
        canonical_event_id,
        is_checkout_form,
        form_type,
        offer_id,
        source_version
    FROM ranked_form_submission_versions
    WHERE current_version_rank = 1 AND source_deleted = 0

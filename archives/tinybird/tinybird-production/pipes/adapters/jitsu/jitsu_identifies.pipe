DESCRIPTION >
    Current identify contract over physical version state.

NODE recently_ingested_identify_keys
SQL >
    %
    SELECT tenant_id, __tb_state_key
    FROM jitsu_identify_versions
    WHERE
        {{ String(p_identity_producer, 'all') }} = 'source_identity:segment_identify'
        AND __tb_state_key != ''
        AND source_ingested_at
        >= toDateTime64({{ String(p_source_ingested_from, '1970-01-01 00:00:00') }}, 6, 'UTC')
    GROUP BY tenant_id, __tb_state_key

NODE ranked_identify_versions
SQL >
    %
    SELECT
        source.*,
        row_number() OVER (
            PARTITION BY source.tenant_id, source.identify_id
            ORDER BY
                source.source_priority DESC,
                source.source_fact_version DESC,
                source.source_ingested_at DESC,
                source.payload_hash DESC
        ) AS current_version_rank
    FROM jitsu_identify_versions AS source
    WHERE
        {{ String(p_identity_producer, 'all') }} = 'all'
        OR (
            {{ String(p_identity_producer, 'all') }} = 'source_identity:segment_identify'
            AND (source.tenant_id, source.__tb_state_key)
            IN (SELECT tenant_id, __tb_state_key FROM recently_ingested_identify_keys)
        )

NODE current_identify_rows
SQL >
    SELECT
        tenant_id,
        identify_id,
        source_system,
        anonymous_id,
        user_id,
        email,
        phone,
        identified_at,
        ip_address,
        user_agent,
        geo_city,
        geo_region,
        geo_country,
        source_version
    FROM ranked_identify_versions
    WHERE current_version_rank = 1 AND source_deleted = 0

DESCRIPTION >
    Materializes new Jitsu Events API page-view versions
    into their append-only canonical state.

NODE materialized_page_view_version_rows
SQL >
    SELECT
        tenant_id,
        source_system,
        source_priority,
        source_deleted,
        source_fact_version,
        source_ingested_at,
        payload_hash,
        page_view_id,
        anonymous_id,
        user_id,
        page_view_timestamp,
        page_url,
        page_path,
        page_title,
        page_referrer,
        ip_address,
        user_agent,
        device_platform,
        device_is_mobile,
        geo_city,
        geo_region,
        geo_region_code,
        geo_country,
        geo_timezone,
        url_utm_source,
        url_utm_medium,
        utm_campaign,
        url_utm_campaign,
        utm_content,
        url_utm_content,
        utm_term,
        utm_id,
        url_utm_id,
        gclid,
        gbraid,
        wbraid,
        stored_fbclid,
        url_fbclid,
        fbclid,
        ttclid,
        li_fat_id,
        rdt_cid,
        twclid,
        fbc,
        fbp,
        ttp,
        uetsid,
        uetvid,
        google_campaign_id,
        google_ad_group_id,
        url_h_ad_id,
        google_keyword_id,
        google_keyword,
        meta_adset_id,
        url_meta_adset_id,
        source_partition_time,
        page_host,
        page_referrer_host,
        utm_source,
        is_identified_meta_ad_click,
        fbclid_observation_type,
        utm_medium,
        page_path_host,
        google_ad_id,
        campaign_id,
        adset_id,
        ad_id,
        click_id,
        click_id_type,
        channel_source,
        channel_medium,
        source_version,
        __tb_state_key
    FROM jitsu_page_views_live_build

TYPE MATERIALIZED
DATASOURCE jitsu_page_view_versions

DESCRIPTION >
    Versioned sessions and touchpoints. Dirty visitors receive replacement rows and tombstones together.

SCHEMA >
    `tenant_id` LowCardinality(String) `json:$.tenant_id`,
    `record_kind` LowCardinality(String) `json:$.record_kind`,
    `record_key` String `json:$.record_key`,
    `batch_version` UInt64 `json:$.batch_version`,
    `batch_id` String `json:$.batch_id`,
    `committed_at` DateTime64(6) `json:$.committed_at`,
    `is_deleted` UInt8 `json:$.is_deleted`,
    `row_hash` FixedString(64) `json:$.row_hash`,
    `visitor_key` String `json:$.visitor_key`,
    `session_id` String `json:$.session_id`,
    `touchpoint_id` String `json:$.touchpoint_id`,
    `profile_id` String `json:$.profile_id`,
    `anonymous_id` String `json:$.anonymous_id`,
    `user_id` String `json:$.user_id`,
    `session_start_timestamp` DateTime64(6) `json:$.session_start_timestamp`,
    `session_end_timestamp` DateTime64(6) `json:$.session_end_timestamp`,
    `session_duration_seconds` Int64 `json:$.session_duration_seconds`,
    `page_view_count` UInt64 `json:$.page_view_count`,
    `first_page_view_id` String `json:$.first_page_view_id`,
    `first_page_url` String `json:$.first_page_url`,
    `first_page_host` String `json:$.first_page_host`,
    `first_page_path` String `json:$.first_page_path`,
    `first_page_path_host` String `json:$.first_page_path_host`,
    `last_page_view_id` String `json:$.last_page_view_id`,
    `last_page_url` String `json:$.last_page_url`,
    `last_page_path` String `json:$.last_page_path`,
    `ip_address` String `json:$.ip_address`,
    `user_agent` String `json:$.user_agent`,
    `device_platform` String `json:$.device_platform`,
    `device_is_mobile` UInt8 `json:$.device_is_mobile`,
    `geo_city` String `json:$.geo_city`,
    `geo_region` String `json:$.geo_region`,
    `geo_region_code` String `json:$.geo_region_code`,
    `geo_country` String `json:$.geo_country`,
    `geo_timezone` String `json:$.geo_timezone`,
    `utm_source` String `json:$.utm_source`,
    `utm_medium` String `json:$.utm_medium`,
    `utm_campaign` String `json:$.utm_campaign`,
    `utm_content` String `json:$.utm_content`,
    `utm_term` String `json:$.utm_term`,
    `utm_id` String `json:$.utm_id`,
    `campaign_id` String `json:$.campaign_id`,
    `adset_id` String `json:$.adset_id`,
    `ad_id` String `json:$.ad_id`,
    `google_keyword_id` String `json:$.google_keyword_id`,
    `google_keyword` String `json:$.google_keyword`,
    `click_id` String `json:$.click_id`,
    `click_id_type` LowCardinality(String) `json:$.click_id_type`,
    `gclid` String `json:$.gclid`,
    `gbraid` String `json:$.gbraid`,
    `wbraid` String `json:$.wbraid`,
    `fbclid` String `json:$.fbclid`,
    `fbc_fbclid` String `json:$.fbc_fbclid`,
    `ttclid` String `json:$.ttclid`,
    `li_fat_id` String `json:$.li_fat_id`,
    `rdt_cid` String `json:$.rdt_cid`,
    `twclid` String `json:$.twclid`,
    `fbc` String `json:$.fbc`,
    `fbp` String `json:$.fbp`,
    `ttp` String `json:$.ttp`,
    `uetsid` String `json:$.uetsid`,
    `uetvid` String `json:$.uetvid`,
    `channel_source` String `json:$.channel_source`,
    `channel_medium` String `json:$.channel_medium`,
    `source_event_ids` Array(String) `json:$.source_event_ids[:]`,
    `visitor_history_hash` FixedString(64) `json:$.visitor_history_hash`

ENGINE "MergeTree"
ENGINE_SORTING_KEY "tenant_id, record_kind, record_key, batch_version, committed_at, row_hash"

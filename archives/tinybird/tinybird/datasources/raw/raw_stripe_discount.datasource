DESCRIPTION >
    Raw schema mirror of able-folio-499722.stripe.discount.
    Source role: discount_evidence.
    Nullable source keys use non-null internal DEFAULT projections for MergeTree sorting.

SCHEMA >
    `amount` Nullable(Int64) `json:$.amount`,
    `id` Nullable(String) `json:$.id`,
    `end` Nullable(DateTime64(6)) `json:$.end`,
    `start` Nullable(DateTime64(6)) `json:$.start`,
    `promotion_code` Nullable(String) `json:$.promotion_code`,
    `checkout_session_line_item_id` Nullable(String) `json:$.checkout_session_line_item_id`,
    `credit_note_line_item_id` Nullable(String) `json:$.credit_note_line_item_id`,
    `coupon_id` Nullable(String) `json:$.coupon_id`,
    `invoice_item_id` Nullable(String) `json:$.invoice_item_id`,
    `checkout_session_id` Nullable(String) `json:$.checkout_session_id`,
    `customer_id` Nullable(String) `json:$.customer_id`,
    `subscription_id` Nullable(String) `json:$.subscription_id`,
    `invoice_id` Nullable(String) `json:$.invoice_id`,
    `type` Nullable(String) `json:$.type`,
    `type_id` Nullable(String) `json:$.type_id`,
    `_fivetran_synced` Nullable(DateTime64(6)) `json:$._fivetran_synced`,
    `__tb_sort_1` String `json:$.__tb_sort_1` DEFAULT ifNull(id, ''),
    `__tb_sort_2` DateTime64(6) `json:$.__tb_sort_2` DEFAULT ifNull(_fivetran_synced, toDateTime64(0, 6))

ENGINE "MergeTree"
ENGINE_SORTING_KEY "__tb_sort_1, __tb_sort_2"

IMPORT_CONNECTION_NAME boom_bigquery_gcs
IMPORT_BUCKET_URI gs://booming-data/tinybird/stripe/discount/**/*.parquet
IMPORT_SCHEDULE '@on-demand'
IMPORT_FORMAT parquet

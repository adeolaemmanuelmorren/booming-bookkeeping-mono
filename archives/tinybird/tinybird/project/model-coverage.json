    {
      "assertion": "definitions/assertions/assert_bbb_installments_use_existing_classifications.sqlx",
      "scope": "bill_release",
      "tinybird_resources": ["stripe_primary_payment_adapter", "current_payment_evidence"],
      "disposition": "structural_rule_lock_plus_branch_gate",
      "operational_equivalent": "The Stripe adapter owns installment classification; branch reconciliation must prove the classified payment rows match Dataform.",
      "evidence_profile": "payment_domain"
    },
    {
      "assertion": "definitions/assertions/assert_identity_identifier_single_profile.sqlx",
      "scope": "shared_dependency",
      "tinybird_resources": ["current_identity_mappings", "current_identity_profiles"],
      "disposition": "structural_rule_lock_plus_branch_gate",
      "operational_equivalent": "The identity oracle locks one current profile per normalized identifier; branch reconciliation must execute the invariant on Tinybird output.",
      "evidence_profile": "identity_domain"
    },
    {
      "assertion": "definitions/assertions/assert_ineligible_attribution_weights_are_zero.sqlx",
      "scope": "outside_bill_output",
      "tinybird_resources": ["generic_conversion_row_presence"],
      "disposition": "outside_bill_output",
      "operational_equivalent": "Bill's product uses explicit first-, last-, and solo-touch rows rather than the general weighted-attribution mart; final report hashes cover the retained behavior.",
      "evidence_profile": "excluded_bill_semantic"
    },
    {
      "assertion": "definitions/assertions/assert_mart_ad_cost_google_matches_staging.sqlx",
      "scope": "outside_bill_output",
      "tinybird_resources": ["google_ad_row_presence_adapter", "google_daily_ad_delivery_contract"],
      "disposition": "outside_bill_output",
      "operational_equivalent": "The four Bill report products do not expose the general Google ad-cost mart. A broader migration must add an executed Google cost reconciliation before claiming parity for that mart.",
      "evidence_profile": "google_source"
    },
    {
      "assertion": "definitions/assertions/assert_mart_ad_cost_meta_matches_staging.sqlx",
      "scope": "outside_bill_output",
      "tinybird_resources": ["meta_daily_delivery_adapter", "meta_hourly_delivery_adapter"],
      "disposition": "outside_bill_output",
      "operational_equivalent": "The general Meta ad-cost mart is outside Bill's four outputs; Bill spend is still required to pass source rollup and ordered-report reconciliation.",
      "evidence_profile": "meta_source"
    },
    {
      "assertion": "definitions/assertions/assert_mart_ad_performance_google_matches_staging.sqlx",
      "scope": "outside_bill_output",
      "tinybird_resources": ["google_ad_row_presence_adapter", "google_daily_ad_delivery_contract"],
      "disposition": "outside_bill_output",
      "operational_equivalent": "Google performance totals are not returned by Bill's four endpoints. A broader migration must execute this reconciliation separately.",
      "evidence_profile": "google_source"
    },
    {
      "assertion": "definitions/assertions/assert_mart_conversions_ad_performance_hourly_rolls_up_to_daily.sqlx",
      "scope": "bill_release",
      "tinybird_resources": ["generic_conversion_row_presence", "bill_hourly_product"],

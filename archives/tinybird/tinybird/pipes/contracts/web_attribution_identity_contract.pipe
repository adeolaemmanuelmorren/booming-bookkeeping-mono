DESCRIPTION >
    Web attribution observations projected into the canonical identity contract.

NODE web_attribution_identity_contract_rows
SQL >
    SELECT
        source_generation_id,
        tenant_id,
        source_system AS source_connection_id,
        concat(source_system, ':attribution') AS source_system,
        observation_id AS source_record_id,
        attribution.observed_at AS source_version,
        attribution.source_version AS source_changed_at,
        observed_at,
        anonymous_id,
        user_id,
        user_id AS email,
        CAST(NULL AS Nullable(String)) AS phone,
        CAST(NULL AS Nullable(String)) AS first_name,
        CAST(NULL AS Nullable(String)) AS last_name,
        toUInt8(0) AS source_deleted
    FROM web_attribution_observation_adapter AS attribution

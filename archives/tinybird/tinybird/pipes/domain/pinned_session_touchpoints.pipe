DESCRIPTION >
    Touchpoints reconstructed as of the report generation's stable session batch. Late
    resessionization versions cannot erase the pinned historical touchpoint during a build.

NODE pinned_touchpoint_versions
SQL >
    SELECT
        state.tenant_id,
        state.record_key,
        generation.source_generation_id,
        generation.identity_stable_batch_version,
        argMax(
            tuple(
                state.is_deleted,
                state.record_kind,
                state.touchpoint_id,
                state.profile_id,
                state.session_start_timestamp,
                state.utm_source,
                state.utm_medium,
                state.utm_campaign,
                state.utm_content,
                state.campaign_id,
                state.adset_id,
                state.ad_id,
                state.channel_source,
                state.channel_medium,
                state.batch_version,
                state.committed_at
            ),
            tuple(state.batch_version, state.committed_at, state.row_hash)
        ) AS pinned_row
    FROM session_state_versions AS state
    INNER JOIN current_source_generation AS generation
        ON state.tenant_id = generation.tenant_id
       AND state.batch_version <= generation.identity_stable_batch_version
    WHERE state.record_kind = 'touchpoint'
    GROUP BY
        state.tenant_id,
        state.record_key,
        generation.source_generation_id,
        generation.identity_stable_batch_version

NODE pinned_live_touchpoint_rows
SQL >
    SELECT
        tenant_id,
        source_generation_id,
        tupleElement(pinned_row, 2) AS record_kind,
        tupleElement(pinned_row, 3) AS touchpoint_id,
        tupleElement(pinned_row, 4) AS profile_id,
        tupleElement(pinned_row, 5) AS session_start_timestamp,
        tupleElement(pinned_row, 6) AS utm_source,
        tupleElement(pinned_row, 7) AS utm_medium,
        tupleElement(pinned_row, 8) AS utm_campaign,
        tupleElement(pinned_row, 9) AS utm_content,
        tupleElement(pinned_row, 10) AS campaign_id,
        tupleElement(pinned_row, 11) AS adset_id,
        tupleElement(pinned_row, 12) AS ad_id,
        tupleElement(pinned_row, 13) AS channel_source,
        tupleElement(pinned_row, 14) AS channel_medium,
        tupleElement(pinned_row, 15) AS batch_version,
        tupleElement(pinned_row, 16) AS committed_at
    FROM pinned_touchpoint_versions
    WHERE tupleElement(pinned_row, 1) = 0

DESCRIPTION >
    Identity mappings reconstructed as of the report generation's stable batch. A newer
    current mapping cannot hide the last mapping version at or before the pin.

NODE pinned_mapping_versions
SQL >
    SELECT
        state.tenant_id,
        state.state_key,
        generation.source_generation_id,
        generation.identity_stable_batch_version,
        argMax(
            tuple(
                state.is_deleted,
                state.identifier_type,
                state.identifier_value,
                state.identifier_key,
                state.profile_id,
                state.batch_version,
                state.committed_at
            ),
            tuple(state.batch_version, state.committed_at, state.row_hash)
        ) AS pinned_row
    FROM identity_state_versions AS state
    INNER JOIN current_source_generation AS generation
        ON state.tenant_id = generation.tenant_id
       AND state.batch_version <= generation.identity_stable_batch_version
    WHERE state.state_kind = 'mapping'
    GROUP BY
        state.tenant_id,
        state.state_key,
        generation.source_generation_id,
        generation.identity_stable_batch_version

NODE pinned_live_mapping_rows
SQL >
    SELECT
        tenant_id,
        source_generation_id,
        tupleElement(pinned_row, 2) AS identifier_type,
        tupleElement(pinned_row, 3) AS identifier_value,
        tupleElement(pinned_row, 4) AS identifier_key,
        tupleElement(pinned_row, 5) AS profile_id,
        tupleElement(pinned_row, 6) AS batch_version,
        tupleElement(pinned_row, 7) AS committed_at
    FROM pinned_mapping_versions
    WHERE tupleElement(pinned_row, 1) = 0

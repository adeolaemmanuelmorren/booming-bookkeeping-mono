DESCRIPTION >
    Logical current identity journal rows selected explicitly with argMax before tombstone filtering.

NODE active_identity_batch
SQL >
    SELECT
        tenant_id,
        max(batch_version) AS active_batch_version
    FROM identity_state_versions
    WHERE tenant_id = 'boom'
      AND state_kind = 'activation_audit'
      AND is_deleted = 0
    GROUP BY tenant_id

NODE journal_versions
SQL >
    SELECT
        journal.tenant_id,
        journal.state_kind,
        journal.state_key,
        argMax(
            tuple(
                is_deleted,
                batch_version,
                batch_id,
                committed_at,
                row_hash,
                identifier_type,
                identifier_value,
                identifier_key,
                profile_id,
                profile_key,
                winner_identifier_key,
                member_identifier_keys,
                anonymous_ids,
                user_ids,
                emails,
                phones,
                historical_profile_ids,
                first_name,
                last_name,
                first_seen_at,
                last_seen_at,
                fact_kind,
                fact_key,
                source_fact_version,
                fact_deleted,
                fact_observed_at,
                fact_payload_hash,
                fact_payload,
                evidence_keys,
                producer_id,
                checkpoint_sequence,
                prior_profile_ids,
                dirty_profile_ids,
                input_event_count,
                input_hash
            ),
            tuple(batch_version, committed_at, row_hash)
        ) AS current_row
    FROM identity_state_versions AS journal
    INNER JOIN active_identity_batch AS active
        ON journal.tenant_id = active.tenant_id
       AND journal.batch_version <= active.active_batch_version
    WHERE journal.tenant_id = 'boom'
    GROUP BY journal.tenant_id, journal.state_kind, journal.state_key

NODE live_journal_rows
SQL >
    SELECT
        tenant_id,
        state_kind,
        state_key,
        tupleElement(current_row, 2) AS batch_version,
        tupleElement(current_row, 3) AS batch_id,
        tupleElement(current_row, 4) AS committed_at,
        tupleElement(current_row, 5) AS row_hash,
        tupleElement(current_row, 6) AS identifier_type,
        tupleElement(current_row, 7) AS identifier_value,
        tupleElement(current_row, 8) AS identifier_key,
        tupleElement(current_row, 9) AS profile_id,
        tupleElement(current_row, 10) AS profile_key,
        tupleElement(current_row, 11) AS winner_identifier_key,
        tupleElement(current_row, 12) AS member_identifier_keys,
        tupleElement(current_row, 13) AS anonymous_ids,
        tupleElement(current_row, 14) AS user_ids,
        tupleElement(current_row, 15) AS emails,
        tupleElement(current_row, 16) AS phones,
        tupleElement(current_row, 17) AS historical_profile_ids,
        tupleElement(current_row, 18) AS first_name,
        tupleElement(current_row, 19) AS last_name,
        tupleElement(current_row, 20) AS first_seen_at,
        tupleElement(current_row, 21) AS last_seen_at,
        tupleElement(current_row, 22) AS fact_kind,
        tupleElement(current_row, 23) AS fact_key,
        tupleElement(current_row, 24) AS source_fact_version,
        tupleElement(current_row, 25) AS fact_deleted,
        tupleElement(current_row, 26) AS fact_observed_at,
        tupleElement(current_row, 27) AS fact_payload_hash,
        tupleElement(current_row, 28) AS fact_payload,
        tupleElement(current_row, 29) AS evidence_keys,
        tupleElement(current_row, 30) AS producer_id,
        tupleElement(current_row, 31) AS checkpoint_sequence,
        tupleElement(current_row, 32) AS prior_profile_ids,
        tupleElement(current_row, 33) AS dirty_profile_ids,
        tupleElement(current_row, 34) AS input_event_count,
        tupleElement(current_row, 35) AS input_hash
    FROM journal_versions
    WHERE tupleElement(current_row, 1) = 0

DESCRIPTION >
    Normalize the complete cutoff-pinned Boom identity universe for the next requested shadow generation.

NODE shadow_request_versions
SQL >
    SELECT
        tenant_id,
        shadow_generation,
        argMax(
            tuple(
                source_generation_id,
                source_manifest_version,
                source_manifest_digest,
                connection_inventory_digest,
                cutoff_set_digest,
                requested_at,
                requested_by,
                reason,
                source_cutoff,
                policy_version,
                request_hash
            ),
            tuple(requested_at, request_hash)
        ) AS current_request
    FROM identity_shadow_requests
    WHERE tenant_id = 'boom'
    GROUP BY tenant_id, shadow_generation

NODE latest_shadow_request
SQL >
    SELECT
        tenant_id,
        argMax(
            tuple(
                shadow_generation,
                tupleElement(current_request, 6),
                tupleElement(current_request, 1),
                tupleElement(current_request, 2),
                tupleElement(current_request, 3),
                tupleElement(current_request, 4),
                tupleElement(current_request, 5),
                tupleElement(current_request, 9),
                tupleElement(current_request, 10),
                tupleElement(current_request, 11)
            ),
            tuple(
                shadow_generation,
                tupleElement(current_request, 6),
                tupleElement(current_request, 11)
            )
        ) AS rebuild_request
    FROM shadow_request_versions
    GROUP BY tenant_id

NODE built_shadow_requests
SQL >
    SELECT DISTINCT
        tenant_id,
        shadow_generation,
        source_generation_id,
        source_manifest_version,
        source_manifest_digest,
        connection_inventory_digest,
        cutoff_set_digest,
        request_hash
    FROM identity_shadow_state_versions
    WHERE tenant_id = 'boom'
      AND state_kind = 'shadow_audit'

NODE exact_shadow_policy
SQL >
    SELECT
        tenant_id,
        max(policy_version) AS policy_version
    FROM current_identifier_policy
    GROUP BY tenant_id
    HAVING min(policy_version) = max(policy_version)
       AND countIf(identifier_type IN ('anonymous_id', 'user_id', 'email', 'canonical_email', 'phone')) = 5
       AND countIf(identifier_type NOT IN ('anonymous_id', 'user_id', 'email', 'canonical_email', 'phone')) = 0

NODE complete_shadow_source_cutoff_bounds
SQL >
    SELECT
        tenant_id,
        source_generation_id,
        max(current_cutoff) AS latest_source_cutoff
    FROM current_source_connection_cutoffs
    GROUP BY tenant_id, source_generation_id
    HAVING count() = countIf(is_complete = 1)

NODE eligible_shadow_request
SQL >
    SELECT
        requests.tenant_id,
        tupleElement(requests.rebuild_request, 3) AS source_generation_id,
        tupleElement(requests.rebuild_request, 4) AS source_manifest_version,
        tupleElement(requests.rebuild_request, 5) AS source_manifest_digest,
        tupleElement(requests.rebuild_request, 6) AS connection_inventory_digest,
        tupleElement(requests.rebuild_request, 7) AS cutoff_set_digest,
        tupleElement(requests.rebuild_request, 1) AS shadow_generation,
        tupleElement(requests.rebuild_request, 2) AS requested_at,
        tupleElement(requests.rebuild_request, 8) AS source_cutoff,
        tupleElement(requests.rebuild_request, 9) AS policy_version,
        tupleElement(requests.rebuild_request, 10) AS request_hash
    FROM latest_shadow_request AS requests
    INNER JOIN exact_shadow_policy AS policy
        ON requests.tenant_id = policy.tenant_id
       AND tupleElement(requests.rebuild_request, 9) = policy.policy_version
    INNER JOIN current_source_generation AS source_generation
       ON requests.tenant_id = source_generation.tenant_id
       AND tupleElement(requests.rebuild_request, 3) = source_generation.source_generation_id
       AND tupleElement(requests.rebuild_request, 4) = source_generation.version
       AND tupleElement(requests.rebuild_request, 5) = source_generation.source_manifest_digest
       AND tupleElement(requests.rebuild_request, 6) = source_generation.connection_inventory_digest
    INNER JOIN complete_shadow_source_cutoff_bounds AS source_cutoffs
        ON requests.tenant_id = source_cutoffs.tenant_id
       AND source_generation.source_generation_id = source_cutoffs.source_generation_id
    INNER JOIN source_generation_cutoff_readiness AS cutoff_readiness
       ON requests.tenant_id = cutoff_readiness.tenant_id
       AND source_generation.source_generation_id = cutoff_readiness.source_generation_id
       AND tupleElement(requests.rebuild_request, 4) = cutoff_readiness.source_manifest_version
       AND tupleElement(requests.rebuild_request, 5) = cutoff_readiness.source_manifest_digest
       AND tupleElement(requests.rebuild_request, 6) = cutoff_readiness.connection_inventory_digest
       AND tupleElement(requests.rebuild_request, 7) = cutoff_readiness.cutoff_set_digest
    LEFT JOIN built_shadow_requests AS built
        ON requests.tenant_id = built.tenant_id
       AND tupleElement(requests.rebuild_request, 1) = built.shadow_generation
       AND tupleElement(requests.rebuild_request, 3) = built.source_generation_id
       AND tupleElement(requests.rebuild_request, 4) = built.source_manifest_version
       AND tupleElement(requests.rebuild_request, 5) = built.source_manifest_digest
       AND tupleElement(requests.rebuild_request, 6) = built.connection_inventory_digest
       AND tupleElement(requests.rebuild_request, 7) = built.cutoff_set_digest
       AND tupleElement(requests.rebuild_request, 10) = built.request_hash
    WHERE built.tenant_id = ''
      AND source_cutoffs.latest_source_cutoff <= tupleElement(requests.rebuild_request, 8)
      AND cutoff_readiness.is_ready = 1

NODE shadow_observation_values
SQL >
    SELECT
        observations.tenant_id,
        request.source_generation_id,
        request.source_manifest_version,
        request.source_manifest_digest,
        request.connection_inventory_digest,
        request.cutoff_set_digest,
        request.shadow_generation,
        request.requested_at,
        request.source_cutoff,
        request.policy_version,
        request.request_hash,
        observations.source_connection_id,
        observations.source_system,
        observations.source_record_id,
        observations.source_version,
        observations.observed_at,
        trim(ifNull(observations.anonymous_id, '')) AS normalized_anonymous_id,
        lower(trim(ifNull(observations.user_id, ''))) AS normalized_user_id,
        lower(trim(ifNull(observations.email, ''))) AS normalized_email,
        replaceRegexpAll(trim(ifNull(observations.phone, '')), '[^0-9]', '') AS phone_digits,
        ifNull(observations.first_name, '') AS first_name,
        ifNull(observations.last_name, '') AS last_name
    FROM identity_observations AS observations
    INNER JOIN eligible_shadow_request AS request
        ON observations.tenant_id = request.tenant_id
       AND observations.source_generation_id = request.source_generation_id
    INNER JOIN current_source_connection_cutoffs AS cutoff
        ON observations.tenant_id = cutoff.tenant_id
       AND observations.source_generation_id = cutoff.source_generation_id
       AND observations.source_connection_id = cutoff.source_connection_id
    WHERE cutoff.is_complete = 1
      AND observations.source_changed_at <= cutoff.current_cutoff

NODE shadow_identity_values
SQL >
    SELECT
        *,
        if(
            normalized_email = '',
            '',
            if(
                splitByChar('@', normalized_email)[2] IN ('gmail.com', 'googlemail.com'),
                concat(
                    replaceAll(
                        replaceRegexpOne(splitByChar('@', normalized_email)[1], '[+].*$', ''),
                        '.',
                        ''
                    ),
                    '@gmail.com'
                ),
                normalized_email
            )
        ) AS canonical_email,
        if(
            length(phone_digits) = 10,
            phone_digits,
            if(length(phone_digits) = 11 AND startsWith(phone_digits, '1'), substring(phone_digits, 2), '')
        ) AS national_phone
    FROM shadow_observation_values

NODE shadow_exact_phone_values
SQL >
    SELECT
        *,
        if(
            match(national_phone, '^[2-9][0-9]{2}[2-9][0-9]{6}$')
            AND substring(national_phone, 4, 3) != '555'
            AND NOT match(national_phone, '(0000000|1111111|2222222|3333333|4444444|5555555|6666666|7777777|8888888|9999999)$')
            AND NOT match(national_phone, '^(0123456789|1234567890|234567890[0-9]|9876543210)$'),
            concat('+1', national_phone),
            ''
        ) AS normalized_phone
    FROM shadow_identity_values

NODE normalized_shadow_identifiers
SQL >
    SELECT
        tenant_id,
        source_generation_id,
        source_manifest_version,
        source_manifest_digest,
        connection_inventory_digest,
        cutoff_set_digest,
        shadow_generation,
        requested_at,
        source_cutoff,
        policy_version,
        request_hash,
        source_connection_id,
        source_system,
        source_record_id,
        concat(
            toString(length(source_connection_id)),
            ':',
            source_connection_id,
            ':',
            toString(length(source_system)),
            ':',
            source_system,
            ':',
            toString(length(source_record_id)),
            ':',
            source_record_id
        ) AS observation_key,
        source_version,
        observed_at,
        tupleElement(identifier, 1) AS identifier_type,
        tupleElement(identifier, 2) AS identifier_value,
        concat(tupleElement(identifier, 1), ':', tupleElement(identifier, 2)) AS identifier_key,
        tupleElement(identifier, 3) AS winner_priority,
        tupleElement(identifier, 4) AS is_public,
        first_name,
        last_name
    FROM shadow_exact_phone_values
    ARRAY JOIN arrayFilter(
        item -> tupleElement(item, 2) != '',
        [
            tuple('anonymous_id', normalized_anonymous_id, toUInt8(4), toUInt8(1)),
            tuple('user_id', normalized_user_id, toUInt8(3), toUInt8(1)),
            tuple('email', normalized_email, toUInt8(1), toUInt8(1)),
            tuple('canonical_email', canonical_email, toUInt8(2), toUInt8(0)),
            tuple('phone', normalized_phone, toUInt8(5), toUInt8(1))
        ]
    ) AS identifier

DESCRIPTION >
    GENERATED from the source registry and canonical contracts. Boom-classified
    payment evidence keeps tenant and source-connection lineage.

NODE registered_current_payment_rows
SQL >
    SELECT
        CAST(rows.source_generation_id AS String) AS source_generation_id,
        CAST(rows.report_generation AS String) AS report_generation,
        CAST(rows.tenant_id AS String) AS tenant_id,
        CAST('stripe-kajabi' AS String) AS source_connection_id,
        CAST(rows.payment_source AS String) AS payment_source,
        CAST(rows.payment_id AS String) AS payment_id,
        CAST(rows.payment_time AS DateTime64(6)) AS payment_time,
        CAST(rows.payment_date AS Date) AS payment_date,
        CAST(rows.customer_id AS Nullable(String)) AS customer_id,
        CAST(rows.payment_email AS Nullable(String)) AS payment_email,
        CAST(rows.payment_name AS Nullable(String)) AS payment_name,
        CAST(rows.payment_phone AS Nullable(String)) AS payment_phone,
        CAST(rows.currency AS Nullable(String)) AS currency,
        CAST(rows.amount_paid AS Decimal(38,9)) AS amount_paid,
        CAST(rows.refund_amount AS Decimal(38,9)) AS refund_amount,
        CAST(rows.net_amount AS Decimal(38,9)) AS net_amount,
        CAST(rows.has_refund AS UInt8) AS has_refund,
        CAST(rows.product_id AS Nullable(String)) AS product_id,
        CAST(rows.product_name AS String) AS product_name,
        CAST(rows.price_id AS Nullable(String)) AS price_id,
        CAST(rows.plan_id AS Nullable(String)) AS plan_id,
        CAST(rows.product_rule AS String) AS product_rule,
        CAST(rows.is_bbb_mentorship_installment AS UInt8) AS is_bbb_mentorship_installment,
        CAST(rows.payment_sequence_number AS Nullable(Int64)) AS payment_sequence_number,
        CAST(rows.payment_occurrence_type AS String) AS payment_occurrence_type,
        CAST(rows.is_repeat_payment AS UInt8) AS is_repeat_payment,
        CAST(rows.payment_category AS String) AS payment_category,
        CAST(rows.payment_intent_id AS Nullable(String)) AS payment_intent_id,
        CAST(rows.payment_method_id AS Nullable(String)) AS payment_method_id,
        CAST(rows.invoice_id AS Nullable(String)) AS invoice_id,
        CAST(rows.subscription_id AS Nullable(String)) AS subscription_id,
        CAST(rows.checkout_session_id AS Nullable(String)) AS checkout_session_id,
        CAST(rows.payment_link_id AS Nullable(String)) AS payment_link_id,
        CAST(rows.invoice_billing_reason AS Nullable(String)) AS invoice_billing_reason,
        CAST(rows.checkout_mode AS Nullable(String)) AS checkout_mode,
        CAST(rows.charge_description AS Nullable(String)) AS charge_description,
        CAST(rows.receipt_url AS Nullable(String)) AS receipt_url,
        CAST(rows.livemode AS Nullable(Bool)) AS livemode,
        CAST(rows.source_changed_at AS DateTime64(6)) AS source_changed_at
    FROM stripe_kajabi_payment_adapter AS rows
    WHERE rows.tenant_id = 'boom'
    UNION ALL
    SELECT
        CAST(rows.source_generation_id AS String) AS source_generation_id,
        CAST(rows.report_generation AS String) AS report_generation,
        CAST(rows.tenant_id AS String) AS tenant_id,
        CAST('stripe-primary' AS String) AS source_connection_id,
        CAST(rows.payment_source AS String) AS payment_source,
        CAST(rows.payment_id AS String) AS payment_id,
        CAST(rows.payment_time AS DateTime64(6)) AS payment_time,
        CAST(rows.payment_date AS Date) AS payment_date,
        CAST(rows.customer_id AS Nullable(String)) AS customer_id,
        CAST(rows.payment_email AS Nullable(String)) AS payment_email,
        CAST(rows.payment_name AS Nullable(String)) AS payment_name,
        CAST(rows.payment_phone AS Nullable(String)) AS payment_phone,
        CAST(rows.currency AS Nullable(String)) AS currency,
        CAST(rows.amount_paid AS Decimal(38,9)) AS amount_paid,
        CAST(rows.refund_amount AS Decimal(38,9)) AS refund_amount,
        CAST(rows.net_amount AS Decimal(38,9)) AS net_amount,
        CAST(rows.has_refund AS UInt8) AS has_refund,
        CAST(rows.product_id AS Nullable(String)) AS product_id,
        CAST(rows.product_name AS String) AS product_name,
        CAST(rows.price_id AS Nullable(String)) AS price_id,
        CAST(rows.plan_id AS Nullable(String)) AS plan_id,
        CAST(rows.product_rule AS String) AS product_rule,
        CAST(rows.is_bbb_mentorship_installment AS UInt8) AS is_bbb_mentorship_installment,
        CAST(rows.payment_sequence_number AS Nullable(Int64)) AS payment_sequence_number,
        CAST(rows.payment_occurrence_type AS String) AS payment_occurrence_type,
        CAST(rows.is_repeat_payment AS UInt8) AS is_repeat_payment,
        CAST(rows.payment_category AS String) AS payment_category,
        CAST(rows.payment_intent_id AS Nullable(String)) AS payment_intent_id,
        CAST(rows.payment_method_id AS Nullable(String)) AS payment_method_id,
        CAST(rows.invoice_id AS Nullable(String)) AS invoice_id,
        CAST(rows.subscription_id AS Nullable(String)) AS subscription_id,
        CAST(rows.checkout_session_id AS Nullable(String)) AS checkout_session_id,
        CAST(rows.payment_link_id AS Nullable(String)) AS payment_link_id,
        CAST(rows.invoice_billing_reason AS Nullable(String)) AS invoice_billing_reason,
        CAST(rows.checkout_mode AS Nullable(String)) AS checkout_mode,
        CAST(rows.charge_description AS Nullable(String)) AS charge_description,
        CAST(rows.receipt_url AS Nullable(String)) AS receipt_url,
        CAST(rows.livemode AS Nullable(Bool)) AS livemode,
        CAST(rows.source_changed_at AS DateTime64(6)) AS source_changed_at
    FROM stripe_primary_payment_adapter AS rows
    WHERE rows.tenant_id = 'boom'

    GROUP BY generation.tenant_id, generation.source_generation_id
    UNION ALL
    SELECT
        generation.tenant_id,
        generation.source_generation_id,
        'web_form_lead_contract' AS adapter_id,
        'lead_evidence_v1' AS contract_name,
        'canonical_required_fields_and_grain' AS validation_name,
        toUInt64(
            countIf(
                rows.contract_row_present = 1
                AND (
                    empty(ifNull(toString(rows.source_generation_id), ''))
                    OR empty(ifNull(toString(rows.tenant_id), ''))
                    OR empty(ifNull(toString(rows.source_connection_id), ''))
                    OR empty(ifNull(toString(rows.lead_id), ''))
                    OR rows.tenant_id != generation.tenant_id
                    OR rows.source_generation_id != generation.source_generation_id
                    OR rows.source_connection_id NOT IN ('boom_domains', 'jitsu_data', 'jitsu_events_api')
                )
            )
            + countIf(rows.contract_row_present = 1)
            - uniqExactIf(tuple(rows.tenant_id, rows.source_connection_id, rows.lead_id), rows.contract_row_present = 1)
        ) AS invalid_row_count
    FROM current_source_generation AS generation
    LEFT JOIN (
        SELECT
            CAST(contract_rows.source_generation_id AS String) AS source_generation_id,
            CAST(contract_rows.tenant_id AS String) AS tenant_id,
            CAST(contract_rows.source_connection_id AS String) AS source_connection_id,
            CAST(contract_rows.lead_id AS String) AS lead_id,
            toUInt8(1) AS contract_row_present
        FROM web_form_lead_contract AS contract_rows
    ) AS rows ON 1 = 1
    GROUP BY generation.tenant_id, generation.source_generation_id

DESCRIPTION >
    Current legacy and Jitsu attribution observations for first-party identity continuity.
    Campaign and click identifiers remain payload context and are not emitted as identity keys.

NODE legacy_attribution_observations
SQL >
    SELECT
        generation.source_generation_id,
        'boom' AS tenant_id,
        'boom_domains' AS source_system,
        toUInt8(1) AS source_priority,
        nullIf(trim(source.id), '') AS observation_id,
        nullIf(trim(source.anonymous_id), '') AS anonymous_id,
        nullIf(lowerUTF8(trim(source.user_id)), '') AS user_id,
        coalesce(source.timestamp, source.sent_at, source.received_at, source.loaded_at, source.original_timestamp, source.uuid_ts) AS observed_at,
        greatest(
            coalesce(source.loaded_at, toDateTime64('1970-01-01 00:00:00', 6, 'UTC')),
            coalesce(source.received_at, toDateTime64('1970-01-01 00:00:00', 6, 'UTC')),
            coalesce(source.sent_at, toDateTime64('1970-01-01 00:00:00', 6, 'UTC')),
            coalesce(source.timestamp, toDateTime64('1970-01-01 00:00:00', 6, 'UTC'))
        ) AS source_version
    FROM raw_boom_domains_attr AS source
    CROSS JOIN current_source_generation AS generation
    WHERE coalesce(source.loaded_at, source.received_at, source.sent_at, source.timestamp)
        <= generation.legacy_event_cutoff

NODE jitsu_attribution_observations
SQL >
    SELECT
        generation.source_generation_id,
        'boom' AS tenant_id,
        'jitsu_data' AS source_system,
        toUInt8(2) AS source_priority,
        nullIf(trim(source.message_id), '') AS observation_id,
        nullIf(trim(source.anonymous_id), '') AS anonymous_id,
        nullIf(lowerUTF8(trim(source.user_id)), '') AS user_id,
        coalesce(source.timestamp, source.sent_at, source.received_at) AS observed_at,
        greatest(
            coalesce(source.received_at, toDateTime64('1970-01-01 00:00:00', 6, 'UTC')),
            coalesce(source.sent_at, toDateTime64('1970-01-01 00:00:00', 6, 'UTC')),
            coalesce(source.timestamp, toDateTime64('1970-01-01 00:00:00', 6, 'UTC'))
        ) AS source_version
    FROM raw_jitsu_data_attr AS source
    CROSS JOIN current_source_generation AS generation
    LEFT JOIN jitsu_events_api_current_versions AS live_tombstone
        ON live_tombstone.tenant_id = generation.tenant_id
       AND live_tombstone.message_id = source.message_id
       AND live_tombstone.source_deleted = 1
    WHERE coalesce(source.received_at, source.sent_at, source.timestamp)
        <= generation.jitsu_event_cutoff
      AND live_tombstone.message_id IS NULL

NODE live_attribution_observations
SQL >
    SELECT
        generation.source_generation_id,
        source.tenant_id,
        'jitsu_events_api' AS source_system,
        toUInt8(3) AS source_priority,
        nullIf(trim(source.message_id), '') AS observation_id,
        nullIf(trim(source.anonymous_id), '') AS anonymous_id,
        nullIf(lowerUTF8(trim(source.user_id)), '') AS user_id,
        source.observed_at,
        source.ingested_at AS source_version
    FROM jitsu_events_api_current_versions AS source
    CROSS JOIN current_source_generation AS generation
    WHERE source.tenant_id = 'boom'
      AND source.event_kind = 'attribution'
      AND source.source_deleted = 0
      AND source.ingested_at <= generation.jitsu_event_cutoff

NODE all_attribution_observation_versions
SQL >
    SELECT * FROM legacy_attribution_observations
    UNION ALL
    SELECT * FROM jitsu_attribution_observations
    UNION ALL
    SELECT * FROM live_attribution_observations

NODE current_attribution_observation_rows
SQL >
    SELECT
        source_generation_id,
        tenant_id,
        source_system,
        observation_id,
        anonymous_id,
        user_id,
        observed_at,
        source_version
    FROM (
        SELECT
            *,
            row_number() OVER (
                PARTITION BY tenant_id, observation_id
                ORDER BY source_priority DESC, source_version DESC
            ) AS source_rank
        FROM all_attribution_observation_versions
    )
    WHERE source_rank = 1

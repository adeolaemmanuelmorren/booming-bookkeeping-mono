DESCRIPTION >
    Append the Meta-hour freshness anchor for one validated shadow generation.

NODE validated_meta_hour_bounds_copy_rows
SQL >
    SELECT product.*
    FROM bill_meta_hour_bounds_product AS product
    INNER JOIN bill_build_readiness AS readiness
        ON product.report_generation = readiness.report_generation
       AND readiness.is_ready = 1

TYPE COPY
TARGET_DATASOURCE bill_meta_hour_bounds_versions
COPY_MODE append

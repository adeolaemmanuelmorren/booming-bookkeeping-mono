{
  "name": "bigquery-tinybird-sync",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "cf-typegen": "WRANGLER_LOG_PATH=/tmp/bigquery-tinybird-sync-wrangler.log wrangler types",
    "check": "npm run manifest:check && npm run typecheck && npm test && npm run test:do",
    "deploy": "wrangler deploy",
    "identity:dry-run": "vite-node scripts/dry-run-identity-worker.ts",
    "identity:repair-bigquery-gap": "vite-node scripts/repair-identity-bigquery-gap.ts",
    "identity:repair-profile-traits": "vite-node scripts/repair-profile-traits.ts",
    "dev": "wrangler dev",
    "manifest:check": "node scripts/generate-table-manifest.mjs --check",
    "manifest:generate": "node scripts/generate-table-manifest.mjs",
    "test": "vitest run",
    "test:do": "WRANGLER_LOG_PATH=/tmp/bigquery-tinybird-sync-tests.log vitest run --config vitest.do.config.mts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:bundle": "WRANGLER_LOG_PATH=/tmp/bigquery-tinybird-sync-wrangler.log wrangler deploy --dry-run --outdir /tmp/bigquery-tinybird-sync-dry-run"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.4",
    "@types/node": "^25.6.0",
    "typescript": "^5.5.2",
    "vitest": "~3.2.0",
    "wrangler": "^4.85.0"
  }
}
